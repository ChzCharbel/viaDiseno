@startuml Diagrama de Despliegue - Sistema de Inscripciones viaDiseno

' Definición de nodos y dispositivos
node "Cliente" {
  [Navegador Web] as browser
}

cloud "Heroku Cloud" <<PaaS>> {
  node "Heroku Dyno" <<container>> {
    frame "Aplicación Node.js" as app <<application>> {
      [Express Server] as server <<web server>>
      [Controllers] as controllers <<component>>
      [Routes] as routes <<component>>
      [Models] as models <<component>>
      [Views (EJS)] as views <<ui>>
      
      server --> routes : enruta peticiones
      routes --> controllers : procesa peticiones
      controllers --> models : gestiona datos
      controllers --> views : renderiza vistas
    }
  }
  
  database "PostgreSQL Database" as db <<database>> {
    [Tablas del Sistema] as tables <<entity>>
  }
  
  node "Admin API" as api <<service>> {
    [Servicios externos] as services
  }
}

' Relaciones entre componentes
browser --> server : HTTP/HTTPS
models --> db : consultas SQL
app --> api : llamadas a API

' Notas adicionales
note right of browser
  Interfaz de usuario accesible 
  a través de cualquier navegador
end note

note bottom of db
  Almacenamiento de datos de usuarios,
  materias, grupos, inscripciones, etc.
end note

note bottom of api
  API externa para servicios
  adicionales (autenticación, etc.)
end note

' Añadir título y leyenda
title Diagrama de Despliegue - Sistema de Inscripciones viaDiseno
legend
  Arquitectura de despliegue en Heroku
  Aplicación: Node.js + Express + EJS
  Base de datos: PostgreSQL
endlegend

@enduml
