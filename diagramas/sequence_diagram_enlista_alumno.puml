@startuml Diagrama de Secuencia - /enlista/alumno

' Definición de actores y componentes
actor "Alumno" as user

' Boundaries (Frontend/UI)
boundary "Navegador" as browser
boundary "Vista (EJS)" as view

' Control (Routes y Controllers)
control "Router Enlista" as router
control "Middleware isAuth" as isAuth
control "Middleware canView" as canView
control "enlistaController" as controller

' Entity (Models y Base de datos)
entity "EnlistaModel" as model
database "PostgreSQL" as db

' Flujo de la secuencia
user -> browser : Accede a /enlista/alumno
browser -> router : GET /enlista/alumno
activate router

router -> router : Verifica ruta y método
router -> isAuth : Aplica middleware de autenticación
activate isAuth

alt Usuario no autenticado
    isAuth --> router : 401 Unauthorized
    router --> browser : Redirecciona a login
    browser --> user : Muestra página de login
else Usuario autenticado
    isAuth --> router : Usuario autenticado
    deactivate isAuth
    
    router -> canView : Aplica middleware de permisos
    activate canView
      canView -> canView : Verifica permisos para ver grupos asignados
    
    alt Sin permisos
        canView --> router : 403 Forbidden
        router --> browser : Muestra error de permisos
        browser --> user : Muestra mensaje de acceso denegado
    else Con permisos
        canView --> router : Usuario tiene permisos
        deactivate canView
        
        router -> controller : Ejecuta get_enlista
        activate controller
          controller -> controller : Verifica sesión y obtiene matrícula
        
        alt Sesión no iniciada
            controller --> router : 401 Unauthorized
            router --> browser : Muestra error de sesión
            browser --> user : Muestra mensaje de sesión no iniciada
        else Sesión válida
            controller -> model : obtenerGruposDeAlumno(matricula)
            activate model
            
            model -> db : Consulta SQL (JOIN entre tablas)
            activate db
            db --> model : Resultados (grupos del alumno)
            deactivate db
            
            model --> controller : Resultados de la consulta
            deactivate model
            
            controller -> controller : Transforma resultados \npara la vista
            controller -> view : Renderiza 'horario_alumnos_regulares' con datos
            activate view
            
            view --> controller : HTML generado
            deactivate view
            
            controller --> server : Respuesta HTML
            deactivate controller
            
            server --> browser : Envía HTML
            browser --> user : Muestra horario de clases
        end
    end
end

' Footer
caption Diagrama de Secuencia para la ruta /enlista/alumno - Sistema de Inscripciones viaDiseno

@enduml
