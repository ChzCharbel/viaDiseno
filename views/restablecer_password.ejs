<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Restablecer Contraseña</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body id="loginBody">
  <div class="container py-4 px-3 mx-auto">
    <div class="row">
      <div class="position-relative">
        <div id="loginCard" class="card align-items-center position-absolute top-50 start-50 translate-middle">
          <div class="row align-items-center mt-4">
            <div class="col-auto mx-auto p-2">
              <img id="loginLogo" class="img-fluid rounded" src="/images/logoviadiseno.jpg">
            </div>
          </div>
          <div class="card-body">
            <% if (error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>
            <% if (info) { %>
              <div class="alert alert-success"><%= info %></div>
            <% } %>

            <form action="/users/restablecer" method="POST" class="needs-validation">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="token" value="<%= token %>">

              <label for="nuevaPassword" class="form-label text-secondary">Nueva contraseña</label>
              <input type="password" class="form-control form-control-lg mb-3" id="nuevaPassword" name="nuevaPassword" required>

              <div class="form-check">
                <input class="form-check-input" type="checkbox" onclick="toggleVisibility()" id="verPassword">
                <label class="form-check-label text-secondary mb-3" for="verPassword">
                  Ver contraseña
                </label>
              </div>

              <div class="text-center">
                <button type="submit" class="btn btn-dark mb-3">Guardar nueva contraseña</button>
              </div>
            </form>

          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function toggleVisibility() {
      const input = document.getElementById('nuevaPassword');
      input.type = input.type === 'password' ? 'text' : 'password';
    }
  </script>

  <script src="/js/scriptIVD.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
