<div class="container mt-0">
    <div class="row text-center" id="alertasContainer">
        <div id="alertasOA">
            <div class="col-9 offset-2 alert alert-info fw-semibold mb-4" role="alert">
                Nota: guarda la oferta académica por semestre
            </div>
        </div>
    </div>
    

    <div class="row mb-3 p-3">
        <div class="col offset-1" id="col_tabs">
            <ul class="nav nav-underline">
                <li class="nav-item">
                    <a class="nav-link link-dark" aria-current="page" href="/oferta_academica/<%= cicloActual %>/plan_version">Materias seleccionadas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link link-dark active" href="/oferta_academica/<%= cicloActual %>/plan_version/agregar">Agregar materias</a>
                </li>
        </div>
        <div class="col-auto">
            <div class="dropdown">
                <a
                class="nav-link dropdown-toggle text-dark"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
                data-bs-target="#dropdown-planes"
                aria-expanded="false"
            >
                Versión del Plan
            </a>
            <ul class="dropdown-menu" id="dropdown-planes">
                <% for (let plan of planes) { %>
                    <% if (plan.id == planActual) {%>
                        <li>
                            <a class="dropdown-item active" id="planActivo" nombrePlan="<%= carrera %> <%= plan.version %>" href="/oferta_academica/<%=cicloActual %>/<%= plan.id %>/agregar"><%= carrera %> <%= plan.version %></a>
                        </li>
                    <% } else { %>
                        <li>
                            <a class="dropdown-item" href="/oferta_academica/<%=cicloActual %>/<%= plan.id %>/agregar"><%= carrera %> <%= plan.version %></a> 
                        </li>
                    <% } } %>
            </ul>
            </div>
        </div>
        <div class="col-auto justify-content-end">

            
            <nav class="search-nav">
                <div class="container-fluid">
                    <form class="d-flex" role="search">
                        <input class="form-control me-2" type="search" placeholder="Materia" aria-label="Search" />
                        <button class="btn btn-outline-success" type="submit">
                            Buscar
                        </button>
                    </form>
                </div>
            </nav> 
        </div>
        
        </ul>
        <br></br>
