                    (materia.plans[0].id == planActual)
                ) { %>
                <tr class="text-center">
                <td><%= materias[i].plans[0].degree.name %> <%= materias[i].plans[0].version%></td>
                <td class="col-2"><%= materia.id %></td>
                <td class="text-start"><%= materia.name %></td>
                <td><%= materia.hours_professor %></td>
                <td><%= materia.credits %></td>
                <td class="text-center">
                    <% let stringMateria = JSON.stringify(materia) %>
                    <button id="boton<%=materia.id%>" class="btn btn-success btn-sm" funcion="agregar" onclick="agregar(`<%= stringMateria %>`)">
                        <i id="iconoBoton<%=materia.id%>" class="bi bi-plus-lg"></i>
                    </button>
                </td>
                </tr>
            <% } } %>
            </tbody>
        </table>
        </div>
    </div>
    
    </div>
</div>
<% } %>
        </div>
        <div class="row mt-3 mb-4">
            <div class="offset-10">
                <button id="botonEnviarOA" class="btn btn-primary visually-hidden" data-bs-toggle="modal" data-bs-target="#ofertaSelected" onclick="enviarSeleccion()">Enviar</button>
            </div>
        </div>
        </div>
        </div>
      </div>
    </div>
  </div>
    <div class="modal fade" id="ofertaSelected" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Materias seleccionadas para el ciclo <%=cicloActual%></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" action="/oferta_academica/<%=cicloActual%>/<%=planActual%>/agregar">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" >
                <input type="hidden" id="idMateriasAgregar" name="idMateriasAgregar" value=""><br>
            <div class="modal-body p-3">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Créditos</th>
                            <th scope="col">Horas por semana</th>
                        </tr>
                    </thead>
                    <tbody id="bodyTablaSelected">
                        
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Confirmar elección</button>
            </div>
            </form>
            </div>
         </div>
     </div>
 </div>
