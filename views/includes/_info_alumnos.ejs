<!-- Buscador estilizado -->
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <form class="input-group shadow rounded-pill overflow-hidden" onsubmit="return false;" role="search">
        <input
          id="buscar"
          name="buscar"
          type="search"
          class="form-control border-0 ps-4"
          placeholder="Buscar alumna o alumno..."
          aria-label="Buscar"
          style="background-color: #f8f9fa;"
        />
        <button class="btn btn-primary rounded-0 rounded-end px-4" type="button">
          <i class="bi bi-search"></i>
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Lista de Alumnos -->
<div class="container mt-5" id="alumnos_lista">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
          <h4 class="text-center mb-4 text-dark fw-semibold">
            <i class="bi bi-person-lines-fill me-2"></i>Alumnas y Alumnos
          </h4>

          <div class="d-grid gap-3" id="alumnos_botones">
            <% for (let alumno of alumnos) { %>
              <% if (alumno.carrera == carrera) { %>
                <button
                  type="button"
                  class="btn btn-outline-primary text-start shadow-sm py-3 px-4 rounded-pill"
                  data-bs-toggle="modal"
                  data-bs-target="#modal<%= alumno.matricula %>"
                >
                  <i class="bi bi-person-fill me-3 fs-5"></i><%= alumno.nombreUsuario %>
                </button>

                <div class="modal fade" id="modal<%= alumno.matricula %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title"><%= alumno.nombreUsuario %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                      </div>
                      <div class="modal-body">
                        <p>
                          <strong>Nombre:</strong> <%= alumno.nombreUsuario %><br>
                          <strong>Matrícula:</strong> <%= alumno.matricula %><br>
                          <strong>Semestre:</strong> <%= alumno.semestre %><br>
                          <strong>Regular:</strong> <%= alumno.regular %><br>
                          <strong>Carrera:</strong> <%= alumno.carrera %><br>
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<script>
  const buscar = document.getElementById('buscar');
  buscar.onkeyup = () => {
    fetch('/alumnos/:idCiclo/buscar/' + buscar.value)
      .then((result) => result.json())
      .then((nombreAlumnos) => {
        const contenedor = document.getElementById('alumnos_botones');
        let html = '';

        for (let alumno of nombreAlumnos.alumno) {
          html += `
            <button
              type="button"
              class="btn btn-outline-primary text-start shadow-sm py-3 px-4 rounded-pill"
              data-bs-toggle="modal"
              data-bs-target="#modal${alumno.matricula}">
              <i class="bi bi-person-fill me-3 fs-5"></i>${alumno.nombreUsuario}
            </button>

            <div class="modal fade" id="modal${alumno.matricula}" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title">${alumno.nombreUsuario}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                  </div>
                  <div class="modal-body">
                    <p>
                      <strong>Nombre:</strong> ${alumno.nombreUsuario}<br>
                      <strong>Matrícula:</strong> ${alumno.matricula}<br>
                      <strong>Semestre:</strong> ${alumno.semestre}<br>
                      <strong>Regular:</strong> ${alumno.regular}<br>
                      <strong>Carrera:</strong> ${alumno.carrera}<br>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          `;
        }

        contenedor.innerHTML = html;
      })
      .catch((error) => console.error(error));
  };
</script>
