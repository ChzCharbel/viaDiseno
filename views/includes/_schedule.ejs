<div class="col-sm-12 col-md-12 col-lg-8 col-xl-8">
    <h3 class="text-center mt-5">Horario</h3>
    <div class="table-responsive">
      <table class="table custom-table p-3 table-striped">
        <thead>
          <tr class="text-center">
            <th class="row-width-hour hour"></th>
            <th class="row-width">Lunes</th>
            <th class="row-width">Martes</th>
            <th class="row-width">Miércoles</th>
            <th class="row-width">Jueves</th>
            <th class="row-width">Viernes</th>
          </tr>
        </thead>
        <tbody>
          <%
          const colores = ['bg-primary', 'bg-success', 'bg-warning', 'bg-danger', 'bg-info', 'bg-secondary', 'bg-dark'];
          const materiasColor = {};
          let colorIndex = 0;
  
          const horario = { Lunes: {}, Martes: {}, Miercoles: {}, Jueves: {}, Viernes: {} };
  
          grupos.forEach(grupo => {
            grupo.horarios.forEach(h => {
              const dia = h.dia.charAt(0).toUpperCase() + h.dia.slice(1);
              
              if (['Lunes', 'Martes', 'Miercoles', 'Jueves', 'Viernes'].includes(dia)) {
                if (!materiasColor[grupo.materia.nombre]) {
                  materiasColor[grupo.materia.nombre] = colores[colorIndex % colores.length];
                  colorIndex++;
                }
                
                // Convertimos las horas de inicio y fin a bloques
                const [hi, mi] = h.hora_inicio.split(':').map(Number);
                const [hf, mf] = h.hora_fin.split(':').map(Number);
                
                const inicioBloque = hi * 2 + (mi >= 30 ? 1 : 0); // cada hora = 2 bloques
                const finBloque = hf * 2 + (mf >= 30 ? 1 : 0);
                
                horario[dia][inicioBloque] = {
                  rowspan: finBloque - inicioBloque,
                  nombre: grupo.materia.nombre,
                  color: materiasColor[grupo.materia.nombre],
                  profesor: grupo.profesor.nombre,
                  salon: grupo.salon.id
                };
                
                for (let b = inicioBloque + 1; b < finBloque; b++) {
                  horario[dia][b] = 'ocupar';
                }
              }
            });
          });
  
          // render de 7:00 a 15:30 = 17 bloques de media hora
          for (let bloque = 14; bloque <= 31; bloque++) {
            const hora = Math.floor(bloque / 2);
            const minutos = bloque % 2 === 0 ? '00' : '30';
          %>
            <tr>
              <th class="hour text-center align-middle"><%= hora %>:<%= minutos %></th>
              <% ['Lunes', 'Martes', 'Miercoles', 'Jueves', 'Viernes'].forEach(dia => { %>
                <% if (horario[dia][bloque] === 'ocupar') return; %>
                <% if (horario[dia][bloque]) { %>
                  <td class="text-white text-center align-middle <%= horario[dia][bloque].color %>" rowspan="<%= horario[dia][bloque].rowspan %>">
                    <%= horario[dia][bloque].nombre %>
                  </td>
                <% } else { %>
                  <td></td>
                <% } %>
              <% }) %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  
    <div class="d-flex justify-content-end mt-3">
      <% 
      const estaInscrito = typeof inscrito !== 'undefined' ? inscrito : false;
      %>
      
      <% if (!estaInscrito) { %>
        <button class="btn btn-secondary me-2" data-bs-toggle="modal" data-bs-target="#modalAgregarMateria" id="btnAgregarMateria">Agregar materia</button>
        <button class="btn btn-primary" id="btnConfirmar">Confirmar</button>
      <% } else { %>
        <div class="alert alert-success" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i>
          <strong>Horario confirmado.</strong> Tu inscripción ha sido completada exitosamente.
        </div>
      <% } %>
    </div>
    <!-- Modal Agregar Materia -->
    <div class="modal fade" id="modalAgregarMateria" tabindex="-1" aria-labelledby="modalAgregarMateriaLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <form id="formAgregarMateria">
            <div class="modal-header">
              <h5 class="modal-title" id="modalAgregarMateriaLabel">Agregar Materia</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="matricula" value="<%= matricula %>">
              <input type="hidden" name="id_ciclo_escolar" value="<%= cicloActual %>">
              <input type="hidden" name="tipo" value="agregar">
              <input type="hidden" name="mensaje" value="">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div class="mb-3">
                <label for="id_materia" class="form-label">Selecciona una materia:</label>

                <select name="id_ciclo_escolar_materia" class="form-select" id="id_materia_dropdown" required>
                  <% materiasDisponibles.forEach(m => { %>
                    <option value="<%= m.id_ciclo_escolar_materia %>"><%= m.nombre_materia %></option>
                  <% }) %>
                </select>

              </div>

              <div class="mb-3">
                <p class="text-muted">Materia seleccionada: <strong id="materiaSeleccionadaTexto"><%= materiasDisponibles[0]?.nombre || '' %></strong></p>
              </div>

              <div class="mb-3">
                <label for="descripcion" class="form-label">Motivo de solicitud:</label>
                <input type="text" class="form-control" name="descripcion" id="descripcion" required>
                <div class="form-text">Explica por qué deseas agregar esta materia.</div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="submit" class="btn btn-primary">Enviar solicitud</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script>
  document.addEventListener("DOMContentLoaded", function () {
    const dropdown = document.getElementById("id_materia_dropdown");
    const textoMateria = document.getElementById("materiaSeleccionadaTexto");
    const btnConfirmar = document.getElementById("btnConfirmar");

    if (dropdown && textoMateria) {
      textoMateria.textContent = dropdown.options[dropdown.selectedIndex]?.text;

      dropdown.addEventListener("change", () => {
        textoMateria.textContent = dropdown.options[dropdown.selectedIndex]?.text;
      });
    }

    if (btnConfirmar) {
      btnConfirmar.addEventListener("click", async function() {
        if (confirm("¿Estás seguro que deseas confirmar tu inscripción? Una vez confirmada, no podrás realizar más cambios.")) {
          try {
            const response = await fetch("/enlista/confirmar", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "CSRF-Token": document.querySelector('input[name="_csrf"]')?.value || ""
              }
            });

            if (!response.ok) throw new Error("Error al confirmar inscripción");

            const result = await response.json();
            alert(result.mensaje || "Inscripción confirmada correctamente");
            
            // Recargar la página para mostrar los cambios actualizados
            window.location.reload();
          } catch (error) {
            console.error(error);
            alert("Ocurrió un error al confirmar la inscripción.");
          }
        }
      });
    }

    document.getElementById("formAgregarMateria")?.addEventListener("submit", async function (e) {
      e.preventDefault();
      const form = e.target;
      const data = {};

      [...form.elements].forEach(input => {
        if (input.name) data[input.name] = input.value;
      });

      try {
        const response = await fetch("/solicitudes/cambio", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "CSRF-Token": form.querySelector('input[name="_csrf"]')?.value || ""
          },
          body: JSON.stringify(data)
        });

        if (!response.ok) throw new Error("Error al enviar solicitud");

        const result = await response.json();
        alert(result.mensaje || "Solicitud enviada correctamente.");
        form.reset();
        bootstrap.Modal.getInstance(document.getElementById("modalAgregarMateria")).hide();
      } catch (error) {
        console.error(error);
        alert("Ocurrió un error al enviar la solicitud.");
      }
    });
  });
</script>

  