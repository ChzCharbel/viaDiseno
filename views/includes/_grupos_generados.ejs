<div class="mt-2 ms-2 p-2">
    <a href="/grupos/opciones/<%=cicloActual%>"><i class="bi bi-arrow-left-circle-fill text-secondary fs-1"></i></a>
</div>
<div class="container mt-2">
    <div class="card mb-4 shadow">
        <div class="card-body">
            <div class="card-title fw-semibold fs-3">¿Cómo funciona?</div>
            <ol class="mt-3">
                <li class="mb-2">
                    Al presionar el botón de generar grupos,  comenzará a correr el algoritmo que creamos para la automatización de los grupos.
                </li>
                <li class="mb-2">
                    Sin embargo, es posible que no se puedan asignar todas las materias, por lo que al finalizar, se mostrará una gráfica con 
            los resultados.
                </li>
                <li class="mb-2">
                    Además, si algún horario no es de tu agrado, te pedimos rechazarlo para poder liberar la disponibilidad del profesor 
                    y así puedas editar manualmente el horario posteriormente. 
                </li>
                <li class="mb-2">Cuando termines, presiona el botón de finalizar, que te redirigirá a la asignación manual de grupos.</li>
            </ol>
            
            Te pedimos paciencia, porque este proceso puede tomar un tiempo. <br>
            ¡Gracias!
        </div>
    </div>
    <% if (grupos.length == 0) { %>
        <a href="/grupos/crear/<%=cicloActual%>" class="btn btn-primary offset-5">Generar grupos</a>
    <% } else { %>
        <div class="accordion mb-4 shadow-sm" id="accordionExample">
            <div class="accordion-item">
                <h2 class="accordion-header">
                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                    <i class="bi bi-file-earmark-bar-graph p-2 fw-bold"> </i>  Gráfica Grupos vs Oferta Académica
                </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <div>
                            <canvas id="graficaBarras" style="width: 100px; height: 300px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion mb-4 shadow-sm" id="accordionTablaOfertaGrupos">
            <div class="accordion-item">
                <h2 class="accordion-header">
                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTablaOfertaGrupos" aria-expanded="true" aria-controls="collapseTablaOfertaGrupos">
                    <i class="bi bi-table p-2 fw-bold"></i> Tabla Oferta Académica vs Materias Asignadas
                </button>
                </h2>
                <div id="collapseTablaOfertaGrupos" class="accordion-collapse collapse" data-bs-parent="#accordionTablaOfertaGrupos">
                <div class="accordion-body">
                    <div class="row">
                        <div class="col">
                            <div class="table-responsive mb-4">
                                <table class="table table-bordered table-hover shadow align-middle text-center overflow-hidden">
                                    <thead class="table-light">
                                        <tr>
                                        <th>Semestre</th>
                                        <th>Profesor(es)</th>
                                        <th>Clave</th>
                                        <th>Materia</th>
                                        <th><a data-bs-toggle="tooltip" data-bs-title="Horas que requiere la materia">Hrs/semana de materia</a></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for (let materia of ofertaAcademica) { %>
                                            <tr>
                                                <td> <%= materia.bloque_semestre %></td>
                                                <td>
                                                    <% for (let profeMateria of profesoresMaterias) { %>
                                                        <% if (profeMateria.id_ciclo_escolar_materia == materia.id_ciclo_escolar_materia) { %>
                                                            <%= profeMateria.profesor %>
                                                    <% } } %>
                                                </td>
                                                <td> <%= materia.id_materia %> </td>
                                                <td> <%= materia.materia %> </td>
                                                <td> <%= materia.horas_profesor %> </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col">
                            <div class="table-responsive mb-4">
                                <table class="table table-bordered table-hover shadow align-middle text-center overflow-hidden">
                                    <thead class="table-light">
                                        <tr>
                                        <th>Semestre</th>
                                        <th>Profesor</th>
                                        <th>Clave</th>
                                        <th>Materia</th>
                                        <th><a data-bs-toggle="tooltip" data-bs-title="Horas totales del grupo">Hrs/semana del grupo</a></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% const gruposMostradosResultados = [] %>
                                        <% for (let grupoResultados of grupos) { %>
                                            <tr>
                                                <% if (gruposMostradosResultados.includes(grupoResultados.id_grupo_horario) === false) { %>
                                                    <td> <%= grupoResultados.bloque_semestre %> </td>
                                                    <td> <%= grupoResultados.profesor %> </td>
                                                    <td> <%= grupoResultados.id_materia %> </td>
                                                    <td> <%= grupoResultados.materia %> </td>
                                                    <td id="celdaComparacion<%=grupoResultados.id_ciclo_escolar_materia%>"></td>
                                                    <% for (let grupoInternoResultados of grupos) { %>
                                                        <% if (grupoInternoResultados.id_ciclo_escolar_materia === grupoResultados.id_ciclo_escolar_materia) { %>
                                                            <span class="visually-hidden">  <%- gruposMostradosResultados.push(grupoInternoResultados.id_grupo_horario) %> </span>
                                                    
                                            </tr>
                                                <% } } } } %>
                                            
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </div>
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-hover shadow align-middle text-center overflow-hidden">
                <thead class="table-light">
                    <tr>
                    <th>Semestre</th>
                    <th>Profesor</th>
                    <th>Clave</th>
                    <th>Materia</th>
                    <th><a data-bs-toggle="tooltip" data-bs-title="Horas que requiere la materia">Hrs/semana materia</a></th>
                    <th><a data-bs-toggle="tooltip" data-bs-title="Horas totales del grupo">Hrs/semana grupo</a></th>
                    <th>Horario</th>
                    <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% const gruposMostrados = [] %>
                    <% for (let grupo of grupos) { %>
                        <tr>
                            <% if (gruposMostrados.includes(grupo.id_grupo_horario) === false) { %>
                                <script src="/js/calculosGruposAutomaticos.js"></script>
                                <td> <%= grupo.bloque_semestre %> </td>
                                <td> <%= grupo.profesor %> </td>
                                <td> <%= grupo.id_materia %> </td>
                                <td> <%= grupo.materia %> </td>
                                <td><%= grupo.horas_profesor %></td>
                                <td id="celda<%=grupo.id_ciclo_escolar_materia%>"> <%= grupo.horas_profesor %> </td>
                                <td>
                                    <script>horasTotalClase = 0;</script>
                                    <% for (let grupoInterno of grupos) { %>
                                        <% if (grupoInterno.id_ciclo_escolar_materia === grupo.id_ciclo_escolar_materia) { %>
                                            <% if (grupoInterno.dia_semana === 'lunes') { %>
                                                <p class="fw-semibold"> Lunes </p>
                                            <% } else if (grupoInterno.dia_semana === 'martes') { %>
                                                <p class="fw-semibold"> Martes </p>
                                            <% } else if (grupoInterno.dia_semana === 'miercoles') { %>
                                                <p class="fw-semibold"> Miércoles </p>
                                            <% } else if (grupoInterno.dia_semana === 'jueves')  { %>
                                                <p class="fw-semibold"> Jueves </p>
                                            <% } else if (grupoInterno.dia_semana === 'viernes') { %>
                                                <p class="fw-semibold"> Viernes </p>
                                            <% } %>
                                            
                                            <p>
                                                <script> stringToTime("<%= grupoInterno.hora_inicio %>","<%= grupoInterno.hora_fin %>", "<%=grupo.id_ciclo_escolar_materia%>")  </script>
                                                
                                                <%=grupoInterno.hora_inicio%> - <%=grupoInterno.hora_fin%> 
                                            </p>
                                            <span class="visually-hidden">  <%- gruposMostrados.push(grupoInterno.id_grupo_horario) %> </span>
                                        
                            <% } } %>
                            </td>
                            <td>
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalRechazarHorario<%=grupo.id_grupo_horario%>">Rechazar</button>
                                <div id="modalRechazarHorario<%=grupo.id_grupo_horario%>" class="modal fade" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered" aria-hidden="true">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h1 class="modal-title fs-5 fw-semibold"> Rechazar grupo </h1> 
                                            </div>
                                            <div class="modal-body">
                                                ¿Estás seguro de que quieres rechazar el grupo generado para <span class="fw-semibold"><em><%= grupo.materia %></em></span>?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <a href="/grupos/rechazar/<%= cicloActual %>/<%= grupo.id_ciclo_escolar_materia %>" class="btn btn-primary">Aceptar</a>
                                            </div>
                                            
                                        </div>
                                        
                                    </div>
                                </div>
                            </td>
                            <% } %>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } %>
    <div class="text-center mb-4">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
        <i class="bi bi-floppy2-fill"></i> Guardar y continuar con creación manual
        </button>
    </div>
    
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Guardar grupos creados automáticamente</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            ¿Estás seguro de que deseas guardar los grupos y continuar con la creción manual?
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <a href="/materias/<%=cicloActual%>" class="btn btn-primary">Confirmar</a>
        </div>
        </div>
    </div>
    </div>
    
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const barras = document.getElementById('graficaBarras');
const pastel = document.getElementById('graficaPastel');

const grupos = JSON.parse(`<%- JSON.stringify(grupos) %>`);
const materiasOfertadas = JSON.parse(`<%- JSON.stringify(ofertaAcademica) %>`);
const grupoMateria = [];

const primero = [];
const primeroOferta = [];
const segundo = [];
const segundoOferta = [];
const tercero = [];
const terceroOferta = [];
const cuarto = [];
const cuartoOferta = [];
const quinto = [];
const quintoOferta = [];
const sexto = [];
const sextoOferta = [];
const septimo = [];
const septimoOferta = [];
const octavo = [];
const octavoOferta = [];
const noveno = [];
const novenoOferta = [];

for (let materia of materiasOfertadas) {
    if (materia.semestre === 1) {
        primeroOferta.push(materia);
    }
    else if (materia.semestre === 2) {
        segundoOferta.push(materia);
    }
    else if (materia.semestre === 3) {
        terceroOferta.push(materia);
    }
    else if (materia.semestre === 4) {
        cuartoOferta.push(materia);
    }
    else if (materia.semestre === 5) {
        quintoOferta.push(materia);
    }
    else if (materia.semestre === 6) {
        sextoOferta.push(materia);
    }
    else if (materia.semestre === 7) {
        septimoOferta.push(materia);
    }
    else if (materia.semestre === 8) {
        octavoOferta.push(materia);
    }
    else if (materia.semestre === 9) {
        novenoOferta.push(materia);
    }
}

for (let grupo of grupos) {
    if (grupoMateria.includes(grupo.id_ciclo_escolar_materia) === false) {
        grupoMateria.push(grupo.id_ciclo_escolar_materia);
        if (grupo.semestre === 1) {
            primero.push(grupo);
        }
        else if (grupo.semestre === 2) {
            segundo.push(grupo);
        }
        else if (grupo.semestre === 3) {
            tercero.push(grupo);
        }
        else if (grupo.semestre === 4) {
            cuarto.push(grupo);
        }
        else if (grupo.semestre === 5) {
            quinto.push(grupo);
        }
        else if (grupo.semestre === 6) {
            sexto.push(grupo);
        }
        else if (grupo.semestre === 7) {
            septimo.push(grupo);
        }
        else if (grupo.semestre === 8) {
            octavo.push(grupo);
        }
        else if (grupo.semestre === 9) {
            noveno.push(grupo);
        }
    }
}
console.log(materiasOfertadas)
console.log(grupoMateria);

new Chart(barras, {
    type: 'bar',
    data: {
        labels: ['1°', '2°', '3°', '4°',
        '5°', '6°', '7°', '8°', '9°'],
        datasets: [{
            label: 'Materias asignadas',
            data: [primero.length, segundo.length, tercero.length, 
            cuarto.length, quinto.length, sexto.length, septimo.length, 
            octavo.length, noveno.length],
            backgroundColor: [
            'rgba(148, 64, 75, 0.8)',
            ],
            borderWidth: 1
        },
        {
            label: 'Oferta académica',
            data: [primeroOferta.length, segundoOferta.length, 
            terceroOferta.length, cuartoOferta.length, quintoOferta.length, 
            sextoOferta.length, septimoOferta.length, octavoOferta.length, 
            novenoOferta.length],
            backgroundColor: [
            'rgba(148, 125, 128, 0.8)',
            ],
            borderWidth: 1
        }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
            title: {
                display: true,
                text: 'Asignación de Materias'
            }
        },
        scales: {
            y: {
            beginAtZero: true
            }
        }
    }
});

</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js" integrity="sha384-b/U6ypiBEHpOf/4+1nzFpr53nxSS+GLCkfwBdFNTxtclqqenISfwAzpKaMNFNmj4" crossorigin="anonymous"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0-beta/js/bootstrap.min.js" integrity="sha384-h0AbiXch4ZDo7tp9hKZ4TsHbi047NrKGLO3SEJAg45jXxnGIfYzk4Si90RDIqNm1" crossorigin="anonymous"></script>
<script src="/js/scriptIVD.js"></script>