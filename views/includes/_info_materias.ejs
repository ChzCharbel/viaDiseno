<div class="container mt-5">
  <!-- Buscador estilizado -->
  <% if (materias && materias.length === 0) { %>
    <p class="text-center">No hay materias disponibles</p>
  <% } else if (materias) { %>
    <div class="row justify-content-center mb-4">
    <div class="col-md-8">
      <div class="card shadow-sm border-0 rounded-4 p-4">
        <h5 class="mb-3 fw-semibold">Buscar materia</h5>
        <form id="editForm" class="d-flex" role="search" onsubmit="return false;">
          <input
            id="inputBuscarMateria"
            class="form-control form-control-lg me-3 rounded-pill"
            type="search"
            placeholder="Materia"
            aria-label="Search"
          />
          <button class="btn btn-outline-success rounded-pill px-4" type="submit">
            Buscar
          </button>
        </form>          
      </div>
    </div>
  </div>

  <input type="hidden" id="cicloActualId" value="<%= cicloActual %>">

  <!-- Tabla de materias -->
  <div class="table-responsive">
    <table class="table table-bordered align-middle text-center shadow-sm overflow-hidden">
      <thead class="table-light">
        <tr>
          <th>Profesor</th>
          <th>Materia</th>
          <th>Salón</th>
          <th>Horario</th>
        </tr>
      </thead>
      <tbody>
        <% const gruposMostradosFinal = [] %>
        <% for (let materia of materias) { %>
          <% if (gruposMostradosFinal.includes(materia.id_grupo_horario) === false) { %>
            <tr>
            <td><%= materia.profesor %></td>
            <td><%= materia.materia %></td>
            <td>
            <% if (materia.id_salon >= 5) { %>
              <%= materia.id_salon + 1 %>
            <% } %>
            </td>
            <td>
              <% for (let grupoInterno of materias) { %>
                <% if (grupoInterno.id_ciclo_escolar_materia === materia.id_ciclo_escolar_materia) { %>
                  <% if (grupoInterno.dia_semana === 'lunes') { %>
                    <p class="fw-semibold"> Lunes </p>
                  <% } else if (grupoInterno.dia_semana === 'martes') { %>
                    <p class="fw-semibold"> Martes </p>
                  <% } else if (grupoInterno.dia_semana === 'miercoles') { %>
                    <p class="fw-semibold"> Miércoles </p>
                  <% } else if (grupoInterno.dia_semana === 'jueves')  { %>
                    <p class="fw-semibold"> Jueves </p>
                  <% } else if (grupoInterno.dia_semana === 'viernes') { %>
                    <p class="fw-semibold"> Viernes </p>
                  <% } %>
                                            
                  <p>
                    <%=grupoInterno.hora_inicio%> - <%=grupoInterno.hora_fin%> 
                  </p>
                  <span class="visually-hidden">  <%- gruposMostradosFinal.push(grupoInterno.id_grupo_horario) %> </span>
                  <% } %>          
              
                
              </td>
            </tr>
          <% } } } } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  localStorage.setItem('cicloActual', '<%= cicloActual %>');
  console.log('Ciclo escolar guardado en localStorage:', '<%= cicloActual %>');
</script>
<script src="/js/asignarSalon.js"></script>
<script src="/js/scriptIVD.js"></script>
<script src="/js/buscadorMaterias.js"></script>
