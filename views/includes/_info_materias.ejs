<div class="container mt-5">
  <!-- Buscador estilizado -->
  <div class="row justify-content-center mb-4">
    <div class="col-md-8">
      <div class="card shadow-sm border-0 rounded-4 p-4">
        <h5 class="mb-3 fw-semibold">Buscar materia</h5>
        <form id="editForm" class="d-flex" role="search" onsubmit="return false;">
          <input
            id="inputBuscarMateria"
            class="form-control form-control-lg me-3 rounded-pill"
            type="search"
            placeholder="Materia"
            aria-label="Search"
          />
          <button class="btn btn-outline-success rounded-pill px-4" type="submit">
            Buscar
          </button>
        </form>
      </div>
    </div>
  </div>

  <input type="hidden" id="cicloActualId" value="<%= cicloActual %>">

  <!-- Tabla de materias -->
  <div class="table-responsive">
    <table class="table table-bordered align-middle text-center shadow-sm overflow-hidden">
      <thead class="table-light">
        <tr>
          <th>Profesor</th>
          <th>Materia</th>
          <th>Salón</th>
          <th>Horario</th>
          <th>Acción</th>
        </tr>
      </thead>
      <tbody>
        <% if (materias && materias.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center py-3">No hay materias disponibles</td>
          </tr>
        <% } else if (materias) { %>
          <% for (let materia of materias) { %>
            <tr>
              <td><%= materia.profesor || 'Sin asignar' %></td>
              <td><%= materia.nombre_materia %></td>

              <!-- Celda de salón -->
              <td>
                <button
                  class="btn btn-outline-primary btn-sm rounded-pill"
                  data-bs-toggle="modal"
                  data-bs-target="#modalSalones<%= materia.id_ciclo_escolar_materia %>">
                  Seleccionar salón
                </button>
                <div id="salonSeleccionado_<%= materia.id_ciclo_escolar_materia %>" class="mt-2 text-muted small">
                  No seleccionado
                </div>
                <input type="hidden" name="salon_<%= materia.id_ciclo_escolar_materia %>" id="inputSalon_<%= materia.id_ciclo_escolar_materia %>">
              </td>

              <!-- Horario -->
              <td>
                <div class="d-flex flex-column align-items-start gap-2">
                  <select id="dia_<%= materia.id_ciclo_escolar_materia %>" class="form-select form-select-sm">
                    <option value="">Selecciona día</option>
                    <option value="Lunes">Lunes</option>
                    <option value="Martes">Martes</option>
                    <option value="Miércoles">Miércoles</option>
                    <option value="Jueves">Jueves</option>
                    <option value="Viernes">Viernes</option>
                  </select>

                  <div class="input-group input-group-sm">
                    <label class="input-group-text">Inicio</label>
                    <input type="time" id="horaInicio_<%= materia.id_ciclo_escolar_materia %>" class="form-control">
                  </div>

                  <div class="input-group input-group-sm">
                    <label class="input-group-text">Fin</label>
                    <input type="time" id="horaFin_<%= materia.id_ciclo_escolar_materia %>" class="form-control">
                  </div>
                </div>
              </td>

              <!-- Botón Guardar salón y horario -->
              <td>
                <button
                  class="btn btn-primary btn-sm rounded-pill px-3"
                  onclick='guardarSalonSeleccionado(
                    "<%= materia.id_ciclo_escolar_materia %>",
                    "<%= materia.id_materia %>",
                    "<%= materia.id_profesor %>"
                  )'>
                  Guardar
                </button>
              </td>
            </tr>

            <!-- Modal de selección de salón -->
            <div class="modal fade" id="modalSalones<%= materia.id_ciclo_escolar_materia %>" tabindex="-1" aria-labelledby="labelSalones<%= materia.id_ciclo_escolar_materia %>" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="labelSalones<%= materia.id_ciclo_escolar_materia %>">
                      Selecciona un salón para <%= materia.nombre_materia %>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                  </div>
                  <div class="modal-body">
                    <% salones.forEach(salon => { %>
                      <button
                        class="btn btn-light w-100 my-1 text-start border"
                        data-salon-id="<%= salon.id_salon %>"
                        onclick="seleccionarSalon('<%= materia.id_ciclo_escolar_materia %>', '<%= salon.id_salon %>', '<%= salon.id_salon %> (<%= salon.descripcion %>)')">
                        <%= salon.id_salon %>.- <b><%= salon.tipo %></b> <br>(<%= salon.descripcion %>)
                      </button>
                    <% }) %>
                    <input type="hidden" id="inputSalon_<%= materia.id_ciclo_escolar_materia %>">
                    <input type="hidden" id="csrfToken_<%= materia.id_ciclo_escolar_materia %>" value="<%= csrfToken %>">
                  </div>
                  <div class="modal-footer">
                    <button
                      type="button"
                      class="btn btn-primary rounded-pill px-4"
                      onclick="guardarSalonSeleccionado('<%= materia.id_ciclo_escolar_materia %>', '<%= materia.id_materia %>', '<%= materia.id_profesor %>')"
                      data-bs-dismiss="modal">
                      Guardar
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Scripts -->
  <script>
    localStorage.setItem('cicloActual', '<%= cicloActual %>');
    console.log('Ciclo escolar guardado en localStorage:', '<%= cicloActual %>');
  </script>
  <script src="/js/asignarSalon.js"></script>
  <script src="/js/scriptIVD.js"></script>
  <script src="/js/buscadorMaterias.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</div>