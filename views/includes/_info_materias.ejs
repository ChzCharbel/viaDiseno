<div class="container mt-5">
    <!-- Buscador estilizado -->
    <div class="row justify-content-center mb-4">
      <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-4 p-4">
          <h5 class="mb-3 fw-semibold">Buscar materia</h5>
          <form id="formBuscarMateria" class="d-flex" role="search" onsubmit="return false;">
            <input
              id="inputBuscarMateria"
              class="form-control form-control-lg me-3 rounded-pill"
              type="search"
              placeholder="Materia"
              aria-label="Search"
            />
            <button class="btn btn-outline-success rounded-pill px-4" type="submit">
              Buscar
            </button>
          </form>          
        </div>
      </div>
    </div>
  
    <!-- Tabla estilizada -->
    <div class="table-responsive">
      <table class="table table-bordered align-middle text-center shadow-sm overflow-hidden">
        <thead class="table-light">
          <tr class="align-middle">
            <th>Carrera</th>
            <th>Materia</th>
            <th>Salón</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (materias.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center py-3">No hay materias disponibles</td>
            </tr>
          <% } else { %>
            <% for (let materia of materias) { %>
              <% 
                const nombreCarrera = materia.plans[0].degree.name;
              %>
              <tr>
                <td><%= nombreCarrera %></td>
                <td><%= materia.name %></td>
                <td>
                  <select class="form-select rounded-pill" name="salon_<%= materia.id %>">
                    <option selected disabled class="texto-pequeno">Selecciona un salón</option>
                    <% for (let salon of salones) { %>
                      <option value="<%= salon.idSalon %>">
                        <%= salon.id_salon %> (<%= salon.descripcion %>)
                      </option>
                    <% } %>
                  </select>
                </td>
                <td>
                  <button class="btn btn-primary btn-sm rounded-pill px-3">Guardar</button>
                </td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  
    <script src="/js/grupos.js"></script>
    <script src="/js/scriptIVD.js"></script>
    <script src="/js/buscadorMaterias.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </div>  