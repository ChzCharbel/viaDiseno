<div class="container mt-5">
  <!-- Buscador estilizado -->
  <% if (materias && materias.length === 0) { %>
    <div class="row justify-content-center mb-4">
    <p class="fs-3">Semestre</p>
      <div class="btn-group mb-4" role="group" aria-label="Basic example">
        <% if (semestreActual == 1) { %> 
          <a href="/grupos/<%=cicloActual%>/1"  class="btn btn-dark">1°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/1"  class="btn btn-outline-dark">1°</a>
        <% } if (semestreActual == 2) { %>
          <a href="/grupos/<%=cicloActual%>/2" class="btn btn-dark">2°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/2" class="btn btn-outline-dark">2°</a>
        <% } if (semestreActual == 3) { %>
          <a href="/grupos/<%=cicloActual%>/3" class="btn btn-dark">3°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/3" class="btn btn-outline-dark">3°</a>
        <% } if (semestreActual == 4) { %>
          <a href="/grupos/<%=cicloActual%>/4" class="btn btn-dark">4°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/4" class="btn btn-outline-dark">4°</a>
        <% } if (semestreActual == 5) { %>
          <a href="/grupos/<%=cicloActual%>/5" class="btn btn-dark">5°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/5" class="btn btn-outline-dark">5°</a>
        <% } if (semestreActual == 6) { %>
          <a href="/grupos/<%=cicloActual%>/6" class="btn btn-dark">6°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/6" class="btn btn-outline-dark">6°</a>
        <% } if (semestreActual == 7) { %>
          <a href="/grupos/<%=cicloActual%>/7" class="btn btn-dark">7°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/7" class="btn btn-outline-dark">7°</a>
        <% } if (semestreActual == 8) { %>
          <a href="/grupos/<%=cicloActual%>/8" class="btn btn-dark">8°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/8" class="btn btn-outline-dark">8°</a>
        <% } if (semestreActual == 9) { %>
          <a href="/grupos/<%=cicloActual%>/9" class="btn btn-dark">9°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/9" class="btn btn-outline-dark">9°</a>
        <% } %>
      </div>
      <p class="text-center">No hay grupos disponibles</p>
  </div>
  <% } else if (materias) { %>
    <div class="row justify-content-center mb-4">
    <div class="col-md-8">
      <div class="card shadow-sm border-0 rounded-4 p-4">
        <h5 class="mb-3 fw-semibold">Buscar materia</h5>
        <form id="editForm" class="d-flex" role="search" onsubmit="return false;">
          <input
            id="inputBuscarMateria"
            class="form-control form-control-lg me-3 rounded-pill"
            type="search"
            placeholder="Materia"
            aria-label="Search"
          />
          <button class="btn btn-outline-success rounded-pill px-4" type="submit">
            Buscar
          </button>
        </form>          
      </div>
    </div>
    <p class="fs-3">Semestre</p>
      <div class="btn-group mb-4" role="group" aria-label="Basic outlined example">
        <% if (semestreActual == 1) { %> 
          <a href="/grupos/<%=cicloActual%>/1"  class="btn btn-dark">1°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/1"  class="btn btn-outline-dark">1°</a>
        <% } if (semestreActual == 2) { %>
          <a href="/grupos/<%=cicloActual%>/2" class="btn btn-dark">2°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/2" class="btn btn-outline-dark">2°</a>
        <% } if (semestreActual == 3) { %>
          <a href="/grupos/<%=cicloActual%>/3" class="btn btn-dark">3°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/3" class="btn btn-outline-dark">3°</a>
        <% } if (semestreActual == 4) { %>
          <a href="/grupos/<%=cicloActual%>/4" class="btn btn-dark">4°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/4" class="btn btn-outline-dark">4°</a>
        <% } if (semestreActual == 5) { %>
          <a href="/grupos/<%=cicloActual%>/5" class="btn btn-dark">5°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/5" class="btn btn-outline-dark">5°</a>
        <% } if (semestreActual == 6) { %>
          <a href="/grupos/<%=cicloActual%>/6" class="btn btn-dark">6°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/6" class="btn btn-outline-dark">6°</a>
        <% } if (semestreActual == 7) { %>
          <a href="/grupos/<%=cicloActual%>/7" class="btn btn-dark">7°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/7" class="btn btn-outline-dark">7°</a>
        <% } if (semestreActual == 8) { %>
          <a href="/grupos/<%=cicloActual%>/8" class="btn btn-dark">8°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/8" class="btn btn-outline-dark">8°</a>
        <% } if (semestreActual == 9) { %>
          <a href="/grupos/<%=cicloActual%>/9" class="btn btn-dark">9°</a>
        <% } else { %>
          <a href="/grupos/<%=cicloActual%>/9" class="btn btn-outline-dark">9°</a>
        <% } %>
      </div>
  </div>

  <input type="hidden" id="cicloActualId" value="<%= cicloActual %>">

  <!-- Tabla de materias -->
  <div class="table-responsive">
    <table class="table table-bordered align-middle text-center shadow-sm overflow-hidden">
      <thead class="table-light">
        <tr>
          <th>Semestre</th>
          <th>Profesor</th>
          <th>Materia</th>
          <th>Salón</th>
          <th>Horario</th>
        </tr>
      </thead>
      <tbody>
        <% const gruposMostradosFinal = [] %>
        <% for (let materia of materias) { %>
          <% if (gruposMostradosFinal.includes(materia.id_grupo_horario) === false) { %>
            <tr>
            <td><%= materia.bloque_semestre %></td>
            <td><%= materia.profesor %></td>
            <td><%= materia.materia %></td>
            <td>
            <% if (materia.id_salon >= 5) { %>
              <%= materia.id_salon + 1 %>
            <% } else { %>
              <%= materia.id_salon %>
            <% } %>
            </td>
            <td>
              <% for (let grupoInterno of materias) { %>
                <% if (grupoInterno.id_ciclo_escolar_materia === materia.id_ciclo_escolar_materia) { %>
                  <% if (grupoInterno.dia_semana === 'lunes') { %>
                    <p class="fw-semibold"> Lunes </p>
                    <p><%=grupoInterno.hora_inicio%> - <%=grupoInterno.hora_fin%> </p>
                  <% } else if (grupoInterno.dia_semana === 'martes') { %>
                    <p class="fw-semibold"> Martes </p>
                    <p><%=grupoInterno.hora_inicio%> - <%=grupoInterno.hora_fin%> </p>
                  <% } else if (grupoInterno.dia_semana === 'miercoles') { %>
                    <p class="fw-semibold"> Miércoles </p>
                    <p><%=grupoInterno.hora_inicio%> - <%=grupoInterno.hora_fin%> </p>
                  <% } else if (grupoInterno.dia_semana === 'jueves')  { %>
                    <p class="fw-semibold"> Jueves </p>
                    <p><%=grupoInterno.hora_inicio%> - <%=grupoInterno.hora_fin%> </p>
                  <% } else if (grupoInterno.dia_semana === 'viernes') { %>
                    <p class="fw-semibold"> Viernes </p>
                    <p><%=grupoInterno.hora_inicio%> - <%=grupoInterno.hora_fin%> </p>
                  <% } %>
                  <span class="visually-hidden">  <%- gruposMostradosFinal.push(grupoInterno.id_grupo_horario) %> </span>
                  <% } %>          
              
                
              
          <% } } %>
          </td>
          <% } %>
        </tr>
       
       
      </tbody>
    </table>
     <% } %>
     <% if (gruposSemestre.length > 0) { %>
      <%- include('_schedule_semestres', { grupos: gruposSemestre }) %>
     <% } %>
  </div>
</div>

<script>
  localStorage.setItem('cicloActual', '<%= cicloActual %>');
  console.log('Ciclo escolar guardado en localStorage:', '<%= cicloActual %>');
    // Agregar evento al botón de generar horarios
  document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('generarHorariosBtn').addEventListener('click', async function() {
      try {
        // Mostrar indicador de carga
        this.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Generando...';
        this.disabled = true;
        
        const cicloActual = document.getElementById('cicloActualId').value;
        
        const response = await fetch('/horario/generarTodos', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= csrfToken %>'
          },
          body: JSON.stringify({ id_ciclo_escolar: cicloActual })
        });
        
        const data = await response.json();
        
        if (response.ok) {
          // Mostrar mensaje de éxito
          alert(`${data.message}\nSe procesaron ${data.detalle ? data.detalle.length : 0} alumnos.`);
        } else {
          // Mostrar mensaje de error
          alert(`Error: ${data.error || 'No se pudieron generar los horarios'}`);
        }
      } catch (error) {
        console.error('Error al generar horarios:', error);
        alert('Ocurrió un error al generar los horarios. Revisa la consola para más detalles.');
      } finally {
        // Restaurar el botón
        this.innerHTML = 'Generar Horarios';
        this.disabled = false;
      }
    });
  });
</script>
<script src="/js/asignarSalon.js"></script>
<script src="/js/scriptIVD.js"></script>
<script src="/js/buscadorMaterias.js"></script>
