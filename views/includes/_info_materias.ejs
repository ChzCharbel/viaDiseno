<div class="container mt-5">
  <!-- Buscador estilizado -->
  <div class="row justify-content-center mb-4">
    <div class="col-md-8">
      <div class="card shadow-sm border-0 rounded-4 p-4">
        <h5 class="mb-3 fw-semibold">Buscar materia</h5>
        <form id="formBuscarMateria" class="d-flex" role="search" onsubmit="return false;">
          <input
            id="inputBuscarMateria"
            class="form-control form-control-lg me-3 rounded-pill"
            type="search"
            placeholder="Materia"
            aria-label="Search"
          />
          <button class="btn btn-outline-success rounded-pill px-4" type="submit">
            Buscar
          </button>
        </form>          
      </div>
    </div>
  </div>

  <!-- Tabla de materias -->
  <div class="table-responsive">
    <table class="table table-bordered align-middle text-center shadow-sm overflow-hidden">
      <thead class="table-light">
        <tr>
          <th>Carrera</th>
          <th>Materia</th>
          <th>Salón</th>
          <th>Horario</th>
          <th>Estatus</th>
        </tr>
      </thead>
      <tbody>
        <% if (materias.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center py-3">No hay materias disponibles</td>
          </tr>
        <% } else { %>
          <% for (let materia of materias) {
               const nombreCarrera = materia.plans[0].degree.name;
          %>
            <tr>
              <td><%= nombreCarrera %></td>
              <td><%= materia.name %></td>
              <td>
                <!-- Botón para abrir modal -->
                <button 
                  type="button" 
                  class="btn btn-outline-secondary btn-sm rounded-pill" 
                  data-bs-toggle="modal" 
                  data-bs-target="#modalSalones<%= materia.id %>">
                  Seleccionar salón
                </button>

                <!-- Incluir modal -->
                <%- include('_modal_salones.ejs', { materia: materia, salones: salones }) %>

                <!-- Texto de salón seleccionado -->
                <div id="salonSeleccionado_<%= materia.id %>" class="mt-2 text-muted small">No seleccionado</div>
                <input type="hidden" name="salon_<%= materia.id %>" id="inputSalon_<%= materia.id %>">
              </td>
              
              <td>
                <!-- Botón para abrir modal -->
                <button 
                  type="button" 
                  class="btn btn-outline-secondary btn-sm rounded-pill" 
                  data-bs-toggle="modal" 
                  data-bs-target="#modalHorario<%= materia.id %>">
                  Seleccionar horario
                </button>
              
                <!-- Modal de horario -->
                <div class="modal fade" id="modalHorario<%= materia.id %>" tabindex="-1" aria-labelledby="modalHorarioLabel<%= materia.id %>" aria-hidden="true">
                  <div class="modal-dialog">
                    <form action="/grupos_horarios/guardar" method="POST">
                      <input type="hidden" name="id_grupo" value="<%= materia.id %>">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="modalHorarioLabel<%= materia.id %>">Asignar horario para <%= materia.name %></h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>

                        

                        <div class="modal-body">
                          <% const dias = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes']; %>
                          <% dias.forEach((dia, index) => { %>
                            <div class="mb-3">
                              <label><strong><%= dia %></strong></label>
                              <div class="input-group">
                                <select name="hora_inicio" class="form-select">
                                  <% for (let h = 7; h <= 16; h++) {
                                       let horaStr = h < 10 ? '0' + h : '' + h;
                                  %>
                                    <option value="<%= horaStr %>:00"><%= horaStr %>:00</option>
                                    <% if (h < 16) { %>
                                      <option value="<%= horaStr %>:30"><%= horaStr %>:30</option>
                                    <% } %>
                                  <% } %>
                                </select>

                                <select name="hora_fin" class="form-select">
                                   <% for (let h = 7; h <= 16; h++) {
                                          let horaStr = h < 10 ? '0' + h : '' + h
                                    ; %>
                                    <option value="<%= horaStr %>:00"><%= horaStr %>:00</option>
                                      <% if (h < 16) { %>
                                        <option value="<%= horaStr %>:30"><%= horaStr %>:30</option>
                                      <% } %>
                                    <% } %>
                                </select>

                                <input type="hidden" name="dia_<%= index %>" value="<%= dia %>">
                              </div>
                            </div>
                          <% }) %>
                        </div>
                        <div class="modal-footer">
                          <button type="submit" class="btn btn-primary">Guardar horario</button>
                        </div>
                      </div>
                    </form>
                  </div>
                </div>
              
                <!-- Vista del horario asignado -->
                <div id="horario_<%= materia.id %>" class="text-muted small mt-2">Sin asignar</div>
              </td>
              

              <td>
                <button class="btn btn-primary btn-sm rounded-pill px-3">Guardar</button>
              </td>
            </tr>
          <% } %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Scripts -->
  <script>
    function seleccionarSalon(idMateria, idSalon, textoSalon) {
      document.getElementById(`salonSeleccionado_${idMateria}`).innerText = textoSalon;
      document.getElementById(`inputSalon_${idMateria}`).value = idSalon;
    }
  </script>

  <script src="/js/grupos.js"></script>
  <script src="/js/scriptIVD.js"></script>
  <script src="/js/buscadorMaterias.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</div>