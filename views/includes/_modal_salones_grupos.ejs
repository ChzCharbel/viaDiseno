<!-- Modal de salones por materia -->
<div
 class="modal fade"
 id="modalSalones<%= materia.id_grupo %>"
 tabindex="-1"
 aria-labelledby="labelSalones<%= materia.id_grupo %>"
 aria-hidden="true">
 <div class="modal-dialog modal-dialog-centered">
   <div class="modal-content">
     <div class="modal-header">
       <h5 class="modal-title" id="labelSalones<%= materia.id_grupo %>">
         Selecciona un salón para <%= materia.nombre_materia %>
       </h5>
       <button
         type="button"
         class="btn-close"
         data-bs-dismiss="modal"
         aria-label="Cerrar">
       </button>
     </div>
     <div class="modal-body">
      <div class="overflow-y-scroll" style="max-height: 20rem;">
       <% salones.forEach(salon => { %>
          <button
           class="btn btn-light w-100 my-1 text-start border"
           data-salon-id="<%= salon.id_salon %>"
           onclick="seleccionarSalonGrupoExistente('<%= materia.id_grupo %>', '<%= salon.id_salon %>', '<%= salon.id_salon %> (<%= salon.descripcion %>)', '<%= cicloActual %>')">
           <%= salon.id_salon %>.-  <b><%= salon.tipo %></b> <br>(<%= salon.descripcion %>)
         </button>
       <% }) %>
       </div>
       <input type="hidden" id="inputSalon_<%= materia.id_grupo %>">
       <input type="hidden" id="csrfToken_<%= materia.id_grupo %>" value="<%= csrfToken %>">
     </div>
     <div class="modal-footer">
       <a id="botonSalonGruposExistentes" class="btn btn-primary btn-sm rounded-pill px-3" href="">Guardar</a>
     </div>
   </div>
 </div>
</div>