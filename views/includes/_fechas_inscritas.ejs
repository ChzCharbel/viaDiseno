<div class="text-center mb-5">
    <h1 class="fw-semibold mb-1" style="font-size: 2.2rem;">
      Bienvenido, <span class="text-danger"><%= username %></span>
    </h1>
  
    <p class="text-muted fs-5 mt-2">
      Estas son las fechas en las que tus estudiantes podrán confirmar su horario.
    </p>
  
    <p class="fs-6 text-secondary mt-3">
      Esta sección corresponde a la semana de inscripciones del ciclo seleccionado.
    </p>
  </div>
  
  <!-- Fechas actuales -->
  <div class="text-center mt-5">
    <% if (ciclo.inicio_inscripcion && ciclo.fin_inscripcion) { %>
      <p class="text-muted">
        <i class="bi bi-info-circle me-2"></i>
        La fecha de inscripciones es del
        <strong>
          <%= new Date(cicloEscolar.inicio_inscripcion).toLocaleDateString('es-MX', { day: 'numeric', month: 'long' }) %>
        </strong> al
        <strong>
          <%= new Date(cicloEscolar.fin_inscripcion).toLocaleDateString('es-MX', { day: 'numeric', month: 'long' }) %>
        </strong>.
      </p>
  
      <a href="/inicio/<%= cicloActual %>?editar=true" class="btn btn-outline-primary mt-4 rounded-pill px-4">
        <i class="bi bi-pencil-square me-2"></i>Modificar fechas
      </a>           
    <% } else { %>
      <p class="text-muted">
        <i class="bi bi-exclamation-circle me-2"></i>
        Aún no se han definido las fechas de inscripción para este ciclo.
      </p>
    <% } %>
  </div>  