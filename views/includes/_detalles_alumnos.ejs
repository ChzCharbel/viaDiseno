<div class="container mt-5">
    <div class="modal-body px-4 pt-2 pb-4">
        <div class="border rounded-3 p-3 bg-light-subtle">
            <div class="row">
                <div class="col">
                    <div class="d-flex justify-content-end">
                        <% if (editar) { %>
                            <a class="btn btn-success shadow-sm me-3" href="/alumnos/<%= cicloActual %>/horario/<%=alumno[0].id_ivd%>">
                            <i class="bi bi-check-circle-fill"></i>
                            </a>
                        <% } else { %>
                            <a class="btn btn-secondary shadow-sm me-3" href="/alumnos/<%= cicloActual %>/horario/<%=alumno[0].id_ivd%>/editar">
                            <i class="bi bi-pencil-square"></i>
                            </a>
                        <% } %>
                        <a href="/alumnos/<%=cicloActual%>" class="btn btn-danger shadow-sm "><i class="bi bi-x-circle-fill text-light "></i></a>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-auto">
                    <p><span class="fw-semibold">Nombre:</span> <%=alumno[0].nombre_usuario%></p>
                    <p><span class="fw-semibold">Matrícula:</span> <%=alumno[0].id_ivd%> </p> 
                    <p><span class="fw-semibold">Semestre:</span> <%=alumno[0].semestre%> </p> 
                    <p><span class="fw-semibold">Estatus:</span> <% if (alumno[0].regular == true) { %>
                        Regular
                        <% } else { %>
                            Irregular
                        <% } %>
                    </p> 
                    <% 
                    const colores = ['bg-primary', 'bg-success', 'bg-warning', 'bg-danger', 'bg-info', 'bg-secondary', 'bg-dark'];
                    const materiasColor = {};
                    let colorIndex = 0;

                    grupos.forEach(grupo => {
                        const nombre = grupo.materia.nombre;
                        if (!materiasColor[nombre]) {
                            materiasColor[nombre] = colores[colorIndex % colores.length];
                            colorIndex++;
                        }
                    });
                    %>          
                    <% const gruposMostradosAlumno = [] %>
                    <% grupos.forEach((grupo, index) => { %>  
                        <% if (gruposMostradosAlumno.includes(grupo.materia.id) === false) { %>    
                            <% gruposMostradosAlumno.push(grupo.materia.id) %>
                            <div class="card mb-3">
                                <div class="card-body">          
                                <h5 class="card-title me-5"><%= grupo.materia.nombre %> </h5>
                                <p class="card-text">Grupo: <%= grupo.idGrupo %></p>
                                <p class="card-text">Profesor: <%= grupo.profesor.nombre %></p>
                                <p class="card-text">Salón: <%= grupo.salon.id %></p>
                                <% if (editar) { %>
                                <button type="button" class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#confirmarEliminar<%= grupo.idGrupo %>">
                                    Eliminar
                                </button>
                                <% } %>
                                <div class="modal fade" id="confirmarEliminar<%= grupo.idGrupo %>" tabindex="-1" aria-labelledby="confirmarEliminar<%= grupo.idGrupo %>" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Eliminar grupo</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        ¿Estás seguro de que quieres <span class="text-danger">eliminar</span>  el grupo de <span class="fw-semibold"><%= grupo.materia.nombre %></span>  del horario del alumno <span class="fw-semibold"><%=alumno[0].id_ivd%> </span>?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <a class="btn btn-primary" href="/alumnos/<%= cicloActual %>/horario/<%=alumno[0].id_ivd%>/eliminar/<%= grupo.materia.id %>">
                                            Aceptar
                                        </a>
                                    </div>
                                    </div>
                                </div>
                                </div>
                                
                                <div class="position-absolute top-0 end-0 bottom-0 ms-3 <%= materiasColor[grupo.materia.nombre] %>" style="width: 30px; border-top-right-radius: 0.375rem; border-bottom-right-radius: 0.375rem;"></div>
                                </div>
                            </div>
                        <% } %>
                    <% })%>
                    </div>
                    <div class="col">
                        <%- include('_schedule_semestres', { grupos: grupos }) %>    
                    </div>
            </div>
        </div>
    </div>
</div>
