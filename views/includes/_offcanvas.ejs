<body>
  <br />
  <div class="container-fluid">
    <button
      class="btn btn-primary material-symbols-outlined"
      type="button"
      data-bs-toggle="offcanvas"
      data-bs-target="#offcanvasWithBothOptions"
      aria-controls="offcanvasWithBothOptions"
    >
      menu
    </button>
  </div>

  <div
    class="offcanvas offcanvas-start"
    data-bs-scroll="true"
    tabindex="-1"
    id="offcanvasWithBothOptions"
    aria-labelledby="offcanvasWithBothOptionsLabel"
  >
    <div class="offcanvas-header">
      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="offcanvas"
        aria-label="Close"
      ></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
      <div
        class="btn-group-vertical w-100 rounded-0"
        role="group"
        aria-label="Menú de navegación vertical"
      >
        <a
          href="/principal/<%=cicloActual%>"
          class="btn btn-outline-danger w-100 rounded-0 fs-2"
          >Inicio</a
        >
        <a
          href="/oferta_academica/<%=cicloActual%>/plan_version"
          class="btn btn-outline-danger w-100 rounded-0 fs-2"
          >Oferta Académica</a
        >
        <a
          href="/maestros/<%=cicloActual%>"
          class="btn btn-outline-danger w-100 rounded-0 fs-2"
          >Profesores</a
        >
        <a
        href="/inicio/<%=cicloActual%>"
        class="btn btn-outline-danger w-100 rounded-0 fs-2"
          >Fechas de inscripciones</a
        >
        <a
        href="/grupos/creados/<%=cicloActual%>"
        class="btn btn-outline-danger w-100 rounded-0 fs-2"
          >Creación de Grupos</a
        >
        <a
          href="/materias/<%=cicloActual%>"
          class="btn btn-outline-danger w-100 rounded-0 fs-2"
          >Grupos</a
        >
        <a
          href="/alumnos/<%=cicloActual%>"
          class="btn btn-outline-danger w-100 rounded-0 fs-2"
          >Alumnos</a
        >
        <a
          href="/solicitudes/<%=cicloActual%>"
          class="btn btn-outline-danger w-100 rounded-0 fs-2"
          >Solicitudes</a
        >
      </div>

      <div class="flex-grow-1"></div>

      
    </div>
  </div>
</body>
