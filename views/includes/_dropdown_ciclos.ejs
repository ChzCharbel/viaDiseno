<!--dropdown de ciclo escolar-->
<!-- Dropdown de ciclo escolar -->
<div class="dropdown me-auto">
  <a
    class="nav-link dropdown-toggle text-light"
    href="#"
    role="button"
    data-bs-toggle="dropdown"
    aria-expanded="false"
  >
    <% for (ciclo of ciclosEscolares) { %>
      <% if (ciclo.id_ciclo_escolar == cicloActual) { %>
      <%= ciclo.ciclo_escolar %>
      <% } } %>
  </a>
  <ul class="dropdown-menu" id="dropdown-menu">
    <div class="dropdown-items-container overflow-auto" style="max-height: 100px">
      <% for (ciclo of ciclosEscolares) { %>
        <% if (ciclo.id_ciclo_escolar == cicloActual) { %>
          <% if (titulo == 'oferta_academica') { %>
            <li>
              <a class="dropdown-item active ciclo-link" 
                 data-ciclo-id="<%= ciclo.id_ciclo_escolar %>"
                 href="/<%= titulo %>/<%= ciclo.id_ciclo_escolar %>/<% if (planActual != '') {%><%=planActual%><%} else {%>plan_version<% } %>"> 
                 <%= ciclo.ciclo_escolar %> 
              </a>
            </li>
          <% } else if (titulo == 'oferta_academica_agregar') { %>
              <li>
              <a class="dropdown-item active ciclo-link"
                 data-ciclo-id="<%= ciclo.id_ciclo_escolar %>"
                 href="/oferta_academica/<%= ciclo.id_ciclo_escolar %>/<% if (planActual != '') {%><%=planActual%><%} else {%>plan_version<% } %>/agregar"> 
                 <%= ciclo.ciclo_escolar %> 
              </a>
            </li>
          <% } else { %> 
              <li>
              <a class="dropdown-item active ciclo-link"
                 data-ciclo-id="<%= ciclo.id_ciclo_escolar %>"
                 href="/<%= titulo %>/<%= ciclo.id_ciclo_escolar %>"> 
                 <%= ciclo.ciclo_escolar %> 
              </a>
            </li>
        <% } } else { %>
          <% if (titulo == 'oferta_academica') { %>
            <li>
              <a class="dropdown-item ciclo-link"
                 data-ciclo-id="<%= ciclo.id_ciclo_escolar %>"
                 href="/<%= titulo %>/<%= ciclo.id_ciclo_escolar %>/<% if (planActual != '') {%><%=planActual%><%} else {%>plan_version<% } %>"> 
                 <%= ciclo.ciclo_escolar %> 
              </a>
            </li>
          <% } else if (titulo == 'oferta_academica_agregar') { %>
              <li>
              <a class="dropdown-item ciclo-link" 
                 data-ciclo-id="<%= ciclo.id_ciclo_escolar %>"
                 href="/oferta_academica/<%= ciclo.id_ciclo_escolar %>/<% if (planActual != '') {%><%=planActual%><%} else {%>plan_version<% } %>/agregar"> 
                 <%= ciclo.ciclo_escolar %> 
              </a>
            </li>
          <% } else { %> 
              <li>
              <a class="dropdown-item ciclo-link"
                 data-ciclo-id="<%= ciclo.id_ciclo_escolar %>"
                 href="/<%= titulo %>/<%= ciclo.id_ciclo_escolar %>"> 
                 <%= ciclo.ciclo_escolar %> 
              </a>
            </li>
          <% } %>
      <% } } %>
    </div>
  </ul>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Checar si hay un ciclo guardado en localStorage
    const cicloGuardado = localStorage.getItem('cicloSeleccionado');
      // Agregar evento click a todos los links de ciclos
    document.querySelectorAll('.ciclo-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        const cicloId = this.getAttribute('data-ciclo-id');
        localStorage.setItem('cicloSeleccionado', cicloId);
      });
    });
    
    if (cicloGuardado && cicloGuardado !== '<%= cicloActual %>') {
      const currentPath = window.location.pathname;
      const currentTitle = '<%= titulo %>';
      
      // Verificar si planActual está definido en la vista actual
      const planActual = '<%= typeof planActual !== "undefined" ? planActual : "" %>';
      
      // Construir la nueva URL basada en el tipo de página
      let newUrl;
      if (currentTitle === 'oferta_academica') {
        newUrl = '/' + currentTitle + '/' + cicloGuardado + '/' + (planActual || 'plan_version');
      } else if (currentTitle === 'oferta_academica_agregar') {
        newUrl = '/oferta_academica/' + cicloGuardado + '/' + (planActual || 'plan_version') + '/agregar';
      } else {
        newUrl = '/' + currentTitle + '/' + cicloGuardado;
      }
      
      // Redirigir solo si la URL cambiaría
      if (currentPath !== newUrl) {
        window.location.href = newUrl;
      }
    }
  });
</script>