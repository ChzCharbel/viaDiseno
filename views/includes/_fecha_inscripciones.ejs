<div class="text-center mb-5">
  <h1 class="fw-semibold mb-1" style="font-size: 2.2rem;">
    Bienvenido, <span class="text-danger"><%= username %></span>
  </h1>

  <p class="text-muted fs-5 mt-2">
    Configura las fechas en las que tus estudiantes podrán confirmar su horario.
  </p>

  <p class="fs-6 text-secondary mt-3">
    Esta sección corresponde a la semana de inscripciones del ciclo actual.
  </p>
</div>


  <form action="/inicio/<%= cicloActual %>" method="POST" class="mx-auto" style="max-width: 700px;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- Fecha de inicio -->
    <div class="mb-4">
      <label for="fechaInicio" class="form-label h5">
        <i class="bi bi-calendar-event me-2 text-primary"></i>Fecha de inicio
      </label>
      <p class="text-muted">Primer día para que los alumnos ingresen a confirmar su horario</p>
      <input type="date" class="form-control form-control-lg shadow-sm" id="fechaInicio" name="fechaInicio" required>
    </div>

    <!-- Fecha de fin -->
    <div class="mb-4">
      <label for="fechaFin" class="form-label h5">
        <i class="bi bi-calendar-x me-2 text-danger"></i>Fecha final
      </label>
      <p class="text-muted">Último día para que los alumnos ingresen a confirmar su horario</p>
      <input type="date" class="form-control form-control-lg shadow-sm" id="fechaFin" name="fechaFin" required>
    </div>

    <!-- Botón de guardar -->
    <div class="text-center mt-4">
      <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill">
        <i class="bi bi-save me-2"></i>Guardar inscripción
      </button>
    </div>
  </form>

  <!-- Fechas actuales -->
  <div class="text-center mt-5">
    <% if (ciclo.inicio_inscripcion && ciclo.fin_inscripcion) { %>
      <p class="text-muted">
        <i class="bi bi-info-circle me-2"></i>
        La fecha de inscripciones es del
        <strong>
          <%= new Date(ciclo.inicio_inscripcion).toLocaleDateString('es-MX', { day: 'numeric', month: 'long' }) %>
        </strong> al
        <strong>
          <%= new Date(ciclo.fin_inscripcion).toLocaleDateString('es-MX', { day: 'numeric', month: 'long' }) %>
        </strong>.
      </p>
    <% } else { %>
      <p class="text-muted">
        <i class="bi bi-exclamation-circle me-2"></i>
        Aún no se han definido las fechas de inscripción para este ciclo.
      </p>
    <% } %>
  </div>
</div>
