
<div class="text-center mb-5">
  <p class="text-muted fs-5 mt-2">
    Configura las fechas en las que tus estudiantes podrán confirmar su horario.
  </p>

  <p class="fs-6 text-secondary mt-3">
    Esta sección corresponde a la semana de inscripciones del ciclo actual.
  </p>
</div>

<form action="/ciclo/inscripciones/<%= cicloActual %>" method="POST" class="mx-auto" style="max-width: 700px;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- Fecha de inicio de inscripción -->
  <div class="mb-4">
    <label for="fechaInicioInscripcion" class="form-label h5">
      <i class="bi bi-calendar-event me-2 text-primary"></i>Fecha de inicio
    </label>
    <p class="text-muted">Primer día para que los alumnos ingresen a confirmar su horario</p>
    <input 
      type="date" 
      class="form-control form-control-lg shadow-sm" 
      id="fechaInicioInscripcion" 
      name="fechaInicioInscripcion" 
      required
      value="<%= cicloEscolar.inicio_inscripcion ? cicloEscolar.inicio_inscripcion.toISOString().substring(0, 10) : '' %>"
    >
  </div>

  <!-- Fecha de fin de inscripción -->
  <div class="mb-4">
    <label for="fechaFinInscripcion" class="form-label h5">
      <i class="bi bi-calendar-x me-2 text-danger"></i>Fecha final
    </label>
    <p class="text-muted">Último día para que los alumnos ingresen a confirmar su horario</p>
    <input 
      type="date" 
      class="form-control form-control-lg shadow-sm" 
      id="fechaFinInscripcion" 
      name="fechaFinInscripcion" 
      required
      value="<%= cicloEscolar.fin_inscripcion ? cicloEscolar.fin_inscripcion.toISOString().substring(0, 10) : '' %>"
    >
  </div>

  <div class="text-center">
    <button type="submit" class="btn btn-primary rounded-pill px-4">
      Guardar fechas
    </button>
  </div>
</form>