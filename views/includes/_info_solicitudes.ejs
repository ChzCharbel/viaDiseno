<div class="container-fluid mt-5 px-4">
  <!-- Filtro y buscador -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <form class="d-flex flex-grow-1 me-3" role="search" onsubmit="return false;">
      <input
        id="buscar"
        name="buscar"
        class="form-control form-control-lg shadow-sm"
        type="search"
        placeholder="Buscar matrícula"
        aria-label="Buscar"
      />
      <button class="btn btn-outline-secondary ms-2" type="submit">
        <i class="bi bi-search"></i>
      </button>
    </form>

    <div>
      <select
        id="filtroEstatus"
        class="form-select form-select-lg shadow-sm"
        style="min-width: 160px;"
      >
        <option value="">Todos</option>
        <option value="Aprobado">Aprobado</option>
        <option value="Pendiente">Pendiente</option>
        <option value="Rechazado">Rechazado</option>
      </select>
    </div>
  </div>

  <!-- Tabla -->
  <div class="table-responsive">
    <table class="table table-hover align-middle shadow-sm">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Nombre</th>
          <th>Correo</th>
          <th>Matrícula</th>
          <th>Descripción</th>
          <th>Estatus</th>
          <th>Mi respuesta</th>
          <th>Fecha solicitud</th>
          <th>Fecha resolución</th>
          <th colspan="2" class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody class="table-group-divider">
        <% SolicitaCambio.forEach((solicitud, index) => { %>
        <tr data-estatus="<%= solicitud.aprobado === true ? 'Aprobado' : solicitud.aprobado === false ? 'Rechazado' :  'Pendiente' %>">
          <th scope="row"><%= index + 1 %></th>
          <td><%= solicitud.nombre_usuario %></td>
          <td><%= solicitud.correo_institucional %></td>
          <td><%= solicitud.id_ivd %></td>
          <td><%= solicitud.descripcion %></td>

          <td class="<%= solicitud.aprobado === true ? 'text-success fw-semibold' : solicitud.aprobado === false ? 'text-danger fw-semibold' : 'text-warning fw-semibold' %>">
            <%= solicitud.aprobado === true ? "Aprobado" : solicitud.aprobado === false ? "Rechazado" : "Pendiente" %>
          </td>
          <td><%=solicitud.mensaje%></td>
          <td>
            <%= solicitud.fecha_solicitud ? solicitud.fecha_solicitud.toISOString().slice(0, 10) : "" %>
          </td>
          <td>
            <%= solicitud.fecha_resolucion ? solicitud.fecha_resolucion.toISOString().slice(0, 10) : "" %>
          </td>
          <td class="text-center">
            <button type="button" class="btn btn-outline-success btn-sm btn-aprobar" data-id="<%= solicitud._id %>">
              <i class="bi bi-check-circle"></i> Aprobar
            </button>
          </td>
          <td class="text-center">
            <button type="button" class="btn btn-outline-danger btn-sm btn-rechazar" data-id="<%= solicitud._id %>">
              <i class="bi bi-x-circle"></i> Rechazar
            </button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  const filtroEstatus = document.getElementById("filtroEstatus");

  filtroEstatus.addEventListener("change", () => {
    const estatusSeleccionado = filtroEstatus.value;
    const filas = document.querySelectorAll("tbody tr");

    filas.forEach((fila) => {
      const estatus = fila.getAttribute("data-estatus");

      if (!estatusSeleccionado || estatus === estatusSeleccionado) {
        fila.style.display = "";
      } else {
        fila.style.display = "none";
      }
    });
  });
</script>
