<div class="container-fluid mt-5 px-4">
  <!-- Filtro y buscador -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <form class="d-flex flex-grow-1 me-3" role="search" onsubmit="return false;">
      <input
        id="buscar"
        name="buscar"
        class="form-control form-control-lg shadow-sm"
        type="search"
        placeholder="Buscar matrícula"
        aria-label="Buscar"
      />
      <button class="btn btn-outline-secondary ms-2" type="submit">
        <i class="bi bi-search"></i>
      </button>
    </form>

    <div>
      <select
        id="filtroEstatus"
        class="form-select form-select-lg shadow-sm"
        style="min-width: 160px;"
      >
        <option value="">Todos</option>
        <option value="Aprobado">Aprobado</option>
        <option value="Pendiente">Pendiente</option>
        <option value="Rechazado">Rechazado</option>
      </select>
    </div>
  </div>

  <!-- Tabla -->
  <div class="table-responsive">
    <table class="table table-hover align-middle shadow-sm">
      <thead class="table-light" className="bg-gray-100 border-b">
        <tr className="bg-white hover:bg-gray-50">
          <th>#</th>
          <th>Nombre</th>
          <th>Correo</th>
          <th>Matrícula</th>
          <th>Descripción</th>
          <th>Estatus</th>
          <th>Mi respuesta</th>
          <th>Fecha solicitud</th>
          <th>Fecha resolución</th>
          <th colspan="2" class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody class="table-group-divider" className="divide-y divide-gray-200">
        <% SolicitaCambio.forEach((solicitud, index) => { %>
        <tr className="bg-white hover:bg-gray-50" data-estatus="<%= solicitud.aprobado === true ? 'Aprobado' : solicitud.aprobado === false ? 'Rechazado' :  'Pendiente' %>">
          <th scope="row"><%= index + 1 %></th>
          <td><%= solicitud.nombre_usuario %></td>
          <td><%= solicitud.correo_institucional %></td>
          <td><%= solicitud.id_ivd %></td>
          <td><%= solicitud.descripcion %></td>

          <td class="<%= solicitud.aprobado === true ? 'text-success fw-semibold' : solicitud.aprobado === false ? 'text-danger fw-semibold' : 'text-warning fw-semibold' %>">
            <%= solicitud.aprobado === true ? "Aprobado" : solicitud.aprobado === false ? "Rechazado" : "Pendiente" %>
          </td>
          <td><%=solicitud.mensaje%></td>
          <td>
            <%= solicitud.fecha_solicitud ? solicitud.fecha_solicitud.toISOString().slice(0, 10) : "" %>
          </td>
          <td>
            <%= solicitud.fecha_resolucion ? solicitud.fecha_resolucion.toISOString().slice(0, 10) : "" %>
          </td>
          <td class="text-center">
            <td class="text-center" colspan="2">
              <button type="button" class="btn btn-primary btn-sm btn-acciones" 
                      data-id="<%= solicitud.id_solicitud %>"
                      data-nombre="<%= solicitud.nombre_usuario %>"
                      data-correo="<%= solicitud.correo_institucional %>"
                      data-matricula="<%= solicitud.id_ivd %>"
                      data-descripcion="<%= solicitud.descripcion %>"
                      data-estatus="<%= solicitud.aprobado %>"
                      data-fecha="<%= solicitud.fecha_solicitud %>"
                      data-mensaje="<%= solicitud.mensaje %>" 
                >
                <i class="bi bi-three-dots-vertical"></i> Acciones
              </button>
            </td>
            
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>


<!-- Modal -->
<div class="modal fade" id="modalAcciones" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <input type="hidden" id="csrfToken" value="<%= csrfToken %>">
      <div class="modal-header">
        <h5 class="modal-title">Detalles de la Solicitud</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      
      <div class="modal-body px-4 py-3">
        <div class="row g-3">
          <div class="col-md-6"><strong>Nombre:</strong> <span id="modal-nombre"></span></div>
          <div class="col-md-6"><strong>Correo:</strong> <span id="modal-correo"></span></div>
          <div class="col-md-6"><strong>Matrícula:</strong> <span id="modal-matricula"></span></div>
          <div class="col-md-6"><strong>Fecha Solicitud:</strong> <span id="modal-fecha"></span></div>
          <div class="col-md-6"><strong>Fecha resolución:</strong> <span id="modal-fecha-resolucion"></span></div>
        </div>

        <div class="mb-3 mt-4"><strong>Descripción:</strong>
          <p id="modal-descripcion" class="border rounded p-2 bg-light"></p>
        </div>

        <div class="mb-3">
          <label for="modal-respuesta" class="form-label"><strong>Mi respuesta:</strong></label>
          <textarea class="form-control" id="modal-respuesta" rows="3" placeholder="Escribe tu respuesta aquí..."></textarea>
        </div>

        <div class="mb-3"><strong>Estatus actual:</strong> <span id="modal-estatus"></span></div>

        <div class="mb-3">
          <strong>Horario:</strong><br>
          <img src="https://www.calendarpedia.com/images-large/espana/horario/horario.png" class="img-fluid rounded border shadow">
        </div>
      </div>

      <div class="modal-footer">
        <button id="btn-aprobar" class="btn btn-success">Aprobar</button>
        <button id="btn-rechazar" class="btn btn-danger">Rechazar</button>
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>



<script>
  const filtroEstatus = document.getElementById("filtroEstatus");

  filtroEstatus.addEventListener("change", () => {
    const estatusSeleccionado = filtroEstatus.value;
    const filas = document.querySelectorAll("tbody tr");

    filas.forEach((fila) => {
      const estatus = fila.getAttribute("data-estatus");

      if (!estatusSeleccionado || estatus === estatusSeleccionado) {
        fila.style.display = "";
      } else {
        fila.style.display = "none";
      }
    });
  });
</script>

<script>
  const csrfToken = document.getElementById("csrfToken").value;
  const modal = new bootstrap.Modal(document.getElementById('modalAcciones'));
  let solicitudActualId = null;

  document.querySelectorAll('.btn-acciones').forEach(button => {
    button.addEventListener('click', () => {
      solicitudActualId = button.dataset.id;
      document.getElementById('modal-nombre').textContent = button.dataset.nombre;
      document.getElementById('modal-correo').textContent = button.dataset.correo;
      document.getElementById('modal-matricula').textContent = button.dataset.matricula;
      document.getElementById('modal-fecha').textContent = button.dataset.fecha;
      document.getElementById('modal-descripcion').textContent = button.dataset.descripcion;
      document.getElementById('modal-fecha-resolucion').textContent = button.closest("tr").querySelector("td:nth-child(9)").textContent || "";
      const estatus = button.dataset.estatus === "true" ? "Aprobado" : button.dataset.estatus === "false" ? "Rechazado" : "Pendiente";
      document.getElementById('modal-estatus').textContent = estatus;
      modal.show();
    });
  });


  function enviarRespuesta(aprobado) {
  const form = document.getElementById("form-respuesta");
  const idSolicitud = form.getAttribute("data-id-solicitud");
  const respuesta = document.getElementById("respuesta").value;

  fetch(`/solicitudes/solicitud/${idSolicitud}`, {
    method: "PUT",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      estatus: aprobado,
      respuesta: respuesta,
    }),
  })
    .then((res) => res.json())
    .then((data) => {
      console.log("Respuesta actualizada:", data);
 
      location.reload(); 
    })
    .catch((err) => {
      console.error("Error:", err);
      alert("Hubo un problema al actualizar la solicitud");
    });
}


async function actualizarEstatus(nuevoEstatus) {
  const respuestaTexto = document.getElementById("modal-respuesta").value;
  
  try {
    const res = await fetch(`/solicitudes/solicitud/${solicitudActualId}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
        'CSRF-Token': csrfToken 
      },
      body: JSON.stringify({
        estatus: nuevoEstatus,
        respuesta: respuestaTexto
      })
    });

    if (res.ok) {
      const updated = await res.json();

      document.getElementById("modal-fecha-resolucion").textContent = updated.fecha_resolucion;

      const fila = document.querySelector(`.btn-acciones[data-id="${solicitudActualId}"]`).closest("tr");

      const estatusCell = fila.querySelector("td:nth-child(6)");
      const nuevoTextoEstatus = nuevoEstatus === true ? "Aprobado" : "Rechazado";
      const claseEstatus = nuevoEstatus === true ? "text-success fw-semibold" : "text-danger fw-semibold";
      estatusCell.textContent = nuevoTextoEstatus;
      estatusCell.className = claseEstatus;

      fila.querySelector("td:nth-child(7)").textContent = respuestaTexto;
      fila.querySelector("td:nth-child(9)").textContent = updated.fecha_resolucion;
      fila.setAttribute("data-estatus", nuevoTextoEstatus);

      modal.hide();
    } else {
      alert("Error al actualizar solicitud");
    }
  } catch (err) {
    console.error(err);
    alert("Error de red al actualizar");
  }
}


  document.getElementById("btn-aprobar").addEventListener("click", () => actualizarEstatus(true));
  document.getElementById("btn-rechazar").addEventListener("click", () => actualizarEstatus(false));
</script>

