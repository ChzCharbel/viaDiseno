<div class="modal fade" id="materiasModal<%= profesor.matricula_profesor %>" tabindex="-1" aria-labelledby="materiasModalLabel<%= profesor.matricula_profesor %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <form action="/maestros/<%= cicloActual %>/asignar-materias" method="POST">

        <input type="hidden" name="id_profesor" value="<%= profesor.id_profesor %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="modal-header">
          <h5 class="modal-title" id="materiasModalLabel<%= profesor.matricula_profesor %>">
            Asignar materias a <%= profesor.profesor %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>

        <div class="modal-body">
          <p class="text-muted mb-3">Seleccione las materias que puede impartir este profesor:</p>

          <!-- Input de búsqueda -->
          <p class="text-muted small mb-1">Buscar materia</p>
          <div class="mb-3">
            <input type="text" class="form-control" id="buscadorMaterias" placeholder="Materia..." onkeyup="filtrarMaterias()">
          </div>

          <% if (materias && materias.length > 0) { %>
            <div id="listaMaterias" class="row scrollable-materias">
              <div class="col-md-6">
                <% for (let i = 0; i < Math.ceil(materias.length/2); i++) { %>
                  <div class="form-check mb-2 materia-item">
                    <input 
                      class="form-check-input" 
                      type="checkbox" 
                      name="materias[]" 
                      value="<%= materias[i].id_ciclo_escolar_materia %>" 
                      id="materia<%= i %>_<%= profesor.matricula_profesor %>"
                      <%= (profesor.materias_asignadas && profesor.materias_asignadas.includes(materias[i].id_ciclo_escolar_materia)) ? 'checked' : '' %>>

                    <label class="form-check-label" for="materia<%= i %>_<%= profesor.matricula_profesor %>">
                      <%= materias[i].nombre_materia %>
                    </label>
                  </div>
                <% } %>
              </div>
              <div class="col-md-6">
                <% for (let i = Math.ceil(materias.length/2); i < materias.length; i++) { %>
                  <div class="form-check mb-2 materia-item">
                    <input 
                      class="form-check-input" 
                      type="checkbox" 
                      name="materias[]" 
                      value="<%= materias[i].id_ciclo_escolar_materia %>" 
                      id="materia<%= i %>_<%= profesor.matricula_profesor %>"
                      <%= (profesor.materias_asignadas && profesor.materias_asignadas.includes(materias[i].id_ciclo_escolar_materia)) ? 'checked' : '' %>>

                    <label class="form-check-label" for="materia<%= i %>_<%= profesor.matricula_profesor %>">
                      <%= materias[i].nombre_materia %>
                    </label>
                  </div>
                <% } %>
              </div>
            </div>
          <% } else { %>
            <div class="alert alert-info">No hay materias disponibles</div>
          <% } %>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success">Guardar Asignaciones</button>

        </div>
      </form>
    </div>
  </div>
</div>

<script>
  window.filtrarMaterias = function () {
    const input = document.getElementById('buscadorMaterias');
    const filter = input.value.toLowerCase();
    const items = document.querySelectorAll('#listaMaterias .materia-item');

    items.forEach(item => {
      const label = item.querySelector('label');
      const texto = label.textContent.toLowerCase();
      item.style.display = texto.includes(filter) ? '' : 'none';
    });
  };

</script>

