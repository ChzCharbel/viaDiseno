<!-- Gráficas lado a lado en una fila -->
<div class="container mt-4">
  <div class="row justify-content-center">
    <!-- Materias por semestre -->
    <div class="col-md-3">
      <div class="card p-3">
        <h6 class="text-center">Materias por Semestre</h6>
        <canvas id="graficoMateriasSemestre" height="80"></canvas>
      </div>
    </div>

    <!-- Alumnos Regulares vs Irregulares -->
    <div class="col-md-3">
      <div class="card p-3">
        <h6 class="text-center">Regulares vs Irregulares</h6>
        <canvas id="graficoRegulares" height="80"></canvas>
      </div>
    </div>

    <!-- Gráfica: Alumnos inscritos -->
    <div class="col-md-4 mb-4">
    <!-- Alumnos Inscritos -->
    <div class="col-md-3">
      <div class="card p-3">
        <h6 class="text-center">Alumnos Inscritos</h6>
        <div class="card-body p-0">
          <%- include('_grafica_alumnos_inscritos') %>
        </div>
      </div>
    </div>

    <!-- Número de Solicitudes -->
    <div class="col-md-3">
      <div class="card p-3">
        <h6 class="text-center">Número de Solicitudes</h6>
        <canvas id="graficoSolicitudes" height="80"></canvas>
      </div>
    </div>
  </div>
</div>



<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  // Materias por semestre
  const materiasData = JSON.parse(`<%- JSON.stringify(materiasPorSemestre || []) %>`);

  const labelsMaterias = materiasData.map(item => `Semestre ${item.semestre}`);
  const dataMaterias = materiasData.map(item => item.cantidad);

  const ctxMaterias = document.getElementById('graficoMateriasSemestre').getContext('2d');

  new Chart(ctxMaterias, {
    type: 'bar',
    data: {
      labels: labelsMaterias,
      datasets: [{
        label: 'Número de materias',
        data: dataMaterias,
        backgroundColor: 'rgba(149, 65, 77, 0.9)',
        borderColor: 'rgba(149, 65, 77, 1)',
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => `${ctx.raw} materias`
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: { display: true, text: 'Materias' }
        },
        x: {
          title: { display: true, text: 'Semestres' }
        }
      }
    }
  });

  // Regulares vs Irregulares
  const regularesData = JSON.parse(`<%- JSON.stringify(regularesIrregulares || []) %>`);

  const labelsRegulares = regularesData.map(d => d.tipo);
  const dataRegulares = regularesData.map(d => d.cantidad);

  const ctxRegulares = document.getElementById('graficoRegulares').getContext('2d');

  new Chart(ctxRegulares, {
    type: 'pie',
    data: {
      labels: labelsRegulares,
      datasets: [{
        label: 'Alumnos',
        data: dataRegulares,
        backgroundColor: [
          'rgba(149, 145, 145, 0.69)',
          'rgba(149, 64, 76, 1)', 
        ],
        borderColor: [
          'rgba(75, 192, 192, 1)',
          'rgba(255, 99, 132, 1)'
        ],
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'bottom'
        },
        tooltip: {
          callbacks: {
            label: ctx => `${ctx.label}: ${ctx.raw} alumno(s)`
          }
        },
        title: {
          display: true,
          text: 'Distribución de alumnos'
        }
      }
    }
  });

  //Numero de solicitudes

const resumenSolicitudes = JSON.parse(`<%- JSON.stringify(resumenSolicitudes || []) %>`);

const etiquetas = ['Aprobadas', 'Rechazadas', 'Pendientes'];
const datos = [
  (resumenSolicitudes.find(s => s.estatus === 'aprobada') || { cantidad: 0 }).cantidad,
  (resumenSolicitudes.find(s => s.estatus === 'rechazada') || { cantidad: 0 }).cantidad,
  (resumenSolicitudes.find(s => s.estatus === 'pendiente') || { cantidad: 0 }).cantidad
];

const ctxSolicitudes = document.getElementById('graficoSolicitudes').getContext('2d');

new Chart(ctxSolicitudes, {
  type: 'pie',
  data: {
    labels: etiquetas,
    datasets: [{
      data: datos,
      backgroundColor: [
        'rgba(0, 128, 0, 1)',     
        'rgba(255, 0, 0, 0.7)',      
        'rgba(149, 64, 76, 1)',      
      ],
      borderColor: [
        'rgba(0, 128, 0, 1)',
        'rgba(255, 0, 0, 0.7)',
        'rgba(149, 64, 76, 1)',
      ],
      borderWidth: 1
    }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { position: 'bottom' },
      title: { display: true, text: 'Distribución de Solicitudes' },
      tooltip: {
        callbacks: {
          label: ctx => `${ctx.label}: ${ctx.raw} solicitudes`
        }
      }
    }
  }
});

</script>