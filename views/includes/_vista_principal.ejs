<!-- Gráficas lado a lado -->
<div class="container mt-4">
  <div class="row justify-content-center">
    <!-- Gráfica: Materias por semestre -->
    <div class="col-md-4">
      <div class="card p-3">
        <h6 class="text-center">Materias por Semestre</h6>
        <canvas id="graficoMateriasSemestre" height="80"></canvas>
      </div>
    </div>

    <!-- Gráfica: Alumnos regulares vs irregulares -->
    <div class="col-md-4">
      <div class="card p-3">
        <h6 class="text-center">Regulares vs Irregulares</h6>
        <canvas id="graficoRegulares" height="80"></canvas>
      </div>
    </div>

    <!-- Gráfica: Alumnos inscritos -->
    <div class="col-md-4 mb-4">
      <div class="card p-3">
        <h6 class="text-center">Alumnos Inscritos</h6>
        <div class="card-body p-0">
          <%- include('_grafica_alumnos_inscritos') %>
        </div>
      </div>
    </div>

    <!-- Gráfica: Grupos creados vs Oferta académica -->

    <div class="col-md-4">
      <div class="card p-3">
        <canvas id="graficaBarras"></canvas>
      </div>
    </div>

  </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  // Materias por semestre
  const materiasData = JSON.parse(`<%- JSON.stringify(materiasPorSemestre || []) %>`);

  const labelsMaterias = materiasData.map(item => `Semestre ${item.semestre}`);
  const dataMaterias = materiasData.map(item => item.cantidad);

  const ctxMaterias = document.getElementById('graficoMateriasSemestre').getContext('2d');

  new Chart(ctxMaterias, {
    type: 'bar',
    data: {
      labels: labelsMaterias,
      datasets: [{
        label: 'Número de materias',
        data: dataMaterias,
        backgroundColor: 'rgba(149, 65, 77, 0.9)',
        borderColor: 'rgba(149, 65, 77, 1)',
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => `${ctx.raw} materias`
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: { display: true, text: 'Materias' }
        },
        x: {
          title: { display: true, text: 'Semestres' }
        }
      }
    }
  });

  // Regulares vs Irregulares
  const regularesData = JSON.parse(`<%- JSON.stringify(regularesIrregulares || []) %>`);

  const labelsRegulares = regularesData.map(d => d.tipo);
  const dataRegulares = regularesData.map(d => d.cantidad);

  const ctxRegulares = document.getElementById('graficoRegulares').getContext('2d');

  new Chart(ctxRegulares, {
    type: 'pie',
    data: {
      labels: labelsRegulares,
      datasets: [{
        label: 'Alumnos',
        data: dataRegulares,
        backgroundColor: [
          'rgba(149, 145, 145, 0.69)',
          'rgba(149, 64, 76, 1)', 
        ],
        borderColor: [
          'rgba(75, 192, 192, 1)',
          'rgba(255, 99, 132, 1)'
        ],
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'bottom'
        },
        tooltip: {
          callbacks: {
            label: ctx => `${ctx.label}: ${ctx.raw} alumno(s)`
          }
        },
        title: {
          display: true,
          text: 'Distribución de alumnos'
        }
      }
    }
  });
</script>

<script>
const barras = document.getElementById('graficaBarras');

const grupos = JSON.parse(`<%- JSON.stringify(grupos) %>`);
const materiasOfertadas = JSON.parse(`<%- JSON.stringify(ofertaAcademica) %>`);
const grupoMateria = [];

const primero = [];
const primeroOferta = [];
const segundo = [];
const segundoOferta = [];
const tercero = [];
const terceroOferta = [];
const cuarto = [];
const cuartoOferta = [];
const quinto = [];
const quintoOferta = [];
const sexto = [];
const sextoOferta = [];
const septimo = [];
const septimoOferta = [];
const octavo = [];
const octavoOferta = [];
const noveno = [];
const novenoOferta = [];

for (let materia of materiasOfertadas) {
    if (materia.semestre === 1) {
        primeroOferta.push(materia);
    }
    else if (materia.semestre === 2) {
        segundoOferta.push(materia);
    }
    else if (materia.semestre === 3) {
        terceroOferta.push(materia);
    }
    else if (materia.semestre === 4) {
        cuartoOferta.push(materia);
    }
    else if (materia.semestre === 5) {
        quintoOferta.push(materia);
    }
    else if (materia.semestre === 6) {
        sextoOferta.push(materia);
    }
    else if (materia.semestre === 7) {
        septimoOferta.push(materia);
    }
    else if (materia.semestre === 8) {
        octavoOferta.push(materia);
    }
    else if (materia.semestre === 9) {
        novenoOferta.push(materia);
    }
}

for (let grupo of grupos) {
    if (grupoMateria.includes(grupo.id_ciclo_escolar_materia) === false) {
        grupoMateria.push(grupo.id_ciclo_escolar_materia);
        if (grupo.semestre === 1) {
            primero.push(grupo);
        }
        else if (grupo.semestre === 2) {
            segundo.push(grupo);
        }
        else if (grupo.semestre === 3) {
            tercero.push(grupo);
        }
        else if (grupo.semestre === 4) {
            cuarto.push(grupo);
        }
        else if (grupo.semestre === 5) {
            quinto.push(grupo);
        }
        else if (grupo.semestre === 6) {
            sexto.push(grupo);
        }
        else if (grupo.semestre === 7) {
            septimo.push(grupo);
        }
        else if (grupo.semestre === 8) {
            octavo.push(grupo);
        }
        else if (grupo.semestre === 9) {
            noveno.push(grupo);
        }
    }
}
console.log(materiasOfertadas)
console.log(grupoMateria);

new Chart(barras, {
    type: 'bar',
    data: {
        labels: ['1°', '2°', '3°', '4°',
        '5°', '6°', '7°', '8°', '9°'],
        datasets: [{
            label: 'Materias asignadas',
            data: [primero.length, segundo.length, tercero.length, 
            cuarto.length, quinto.length, sexto.length, septimo.length, 
            octavo.length, noveno.length],
            backgroundColor: [
            'rgba(148, 64, 75, 0.8)',
            ],
            borderWidth: 1
        },
        {
            label: 'Oferta académica',
            data: [primeroOferta.length, segundoOferta.length, 
            terceroOferta.length, cuartoOferta.length, quintoOferta.length, 
            sextoOferta.length, septimoOferta.length, octavoOferta.length, 
            novenoOferta.length],
            backgroundColor: [
            'rgba(148, 125, 128, 0.8)',
            ],
            borderWidth: 1
        }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
            title: {
                display: true,
                text: 'Asignación de Materias'
            }
        },
        scales: {
            y: {
            beginAtZero: true
            }
        }
    }
});

</script>