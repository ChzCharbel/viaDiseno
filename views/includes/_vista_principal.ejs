<p>esta es la vista donde van las estadísticas</p>

<div class="container d-flex justify-content-center">
  <div class="card p-4 mt-4" style="width: 80%">
    <div class="card-header">
      <h5 class="text-center">Materias Por Semestre</h5>
    </div>
    <div class="card-body">
      <canvas id="graficoMateriasSemestre" height="100"></canvas>
    </div>
  </div>
</div>

<div class="container d-flex justify-content-center">
  <div class="card p-4 mt-4" style="width: 80%">
    <div class="card-header">
      <h5 class="text-center">Alumnos Inscritos</h5>
    </div>
    <div class="card-body">
      <%- include('_grafica_alumnos_inscritos', { inscritos: inscritos,
      noInscritos: noInscritos }) %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const materiasData = <%- JSON.stringify(materiasPorSemestre || []) %>;

    const labels = materiasData.map(item => `Semestre ${item.semestre}`);
    const data = materiasData.map(item => item.cantidad);

    const ctx = document.getElementById('graficoMateriasSemestre').getContext('2d');

    const graficoMaterias = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: 'Número de materias',
          data: data,
          backgroundColor: 'rgba(149, 65, 77, 0.9)',
          borderColor: 'rgba(149, 65, 77, 1)',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            callbacks: {
              label: (ctx) => `${ctx.raw} materias`
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            title: {
              display: true,
              text: 'Materias'
            }
          },
          x: {
            title: {
              display: true,
              text: 'Semestres'
            }
          }
        }
      }
    });
  </script>
</div>
