<div class="container mt-0">
    <div class="row mb-3 p-3">
        <div class="col offset-1" id="col_tabs">
            <ul class="nav nav-underline">
                <li class="nav-item">
                    <a class="nav-link link-dark active" aria-current="page" href="/oferta_academica/<%= cicloActual %>/plan_version">Materias seleccionadas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link link-dark" href="/oferta_academica/<%= cicloActual %>/plan_version/agregar">Agregar materias</a>
                </li>
        </div>
    <% 
                let count = 0; 
                for (let i = 0; i < materias.length; i++) {
                const materia = materias[i];
                if (count % 4 === 0) { %>
                    </div><div class="row">
                <% } %>
                <div class="col-sm-6 col-md-3 mb-4"> 
                <div class="card" style="width: 100%;">
                    <img src="/images/95404c.png" class="card-img-top" alt="color" height="150" />
                    <div class="card-body">
                    <h5 class="card-title"><%= materia.nombreMateria %></h5>
                    <div class="row">
                        <div class="col text-start">
                        <button class="btn" data-bs-toggle="popover" data-bs-title="Especificaciones" data-bs-placement="bottom" data-bs-content="Créditos: <%= materia.creditos %>">
                            <i class="bi bi-info-circle"></i>
                        </button>
                        </div>
                    </div>
                    </div>
                </div>
                </div>
            <% count++; }  %>
            </div><div class="row"></div>
    </div>
</div>


    <script src="/js/scriptIVD.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>