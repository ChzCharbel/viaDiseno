<div class="container mt-4">
    <!-- Tabs de navegación (sin cambios visuales) -->
    <div class="row mb-5 p-3">
      <div class="col-auto" id="col_tabs">
        <ul class="nav nav-underline">
          <li class="nav-item">
            <a class="nav-link link-dark active" aria-current="page" href="/oferta_academica/<%= cicloActual %>/<%= planActual %>">
              Materias seleccionadas
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link link-dark" href="/oferta_academica/<%= cicloActual %>/<%= planActual %>/agregar">
              Agregar materias
            </a>
          </li>
        </ul>
      </div>
      <div class="col">
        <div class="d-flex">
          <% if (editar == true) { %>
            <form class="ms-auto" method="POST" action="/oferta_academica/<%=cicloActual%>/<%=planActual%>/editar">
                <button class="btn btn-success shadow-sm" type="submit">
                  <i class="bi bi-check-circle-fill"></i>
                </button>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" >
                <input type="hidden" id="idMateriasActualizar" name="idMateriasActualizar" value=""><br>
                <input type="hidden" id="bloqueSemestres" name="bloqueSemestres" value=""><br>
            </form>
          <% } else { %>
            <a class="btn btn-secondary shadow-sm ms-auto" href="/oferta_academica/<%= cicloActual %>/<%= planActual %>/editar">
              <i class="bi bi-pencil-square"></i>
            </a>
          <% } %>
        </div>
      </div>
    </div>
  
    <!-- Tabla de materias -->
    <div class="row px-3">
      <div class="col-12">
        <div class="table-responsive">
          <table class="table table-striped table-hover shadow-sm">
            <thead class="table-light">
              <tr class="text-center">
                <% if (editar == true) { %>
                <th scope="col-auto text-center" data-bs-toggle="tooltip" 
                data-bs-placement="top" 
                data-bs-title="Escoge el semestre al que se le impartirá la materia">Semestre</th>
                <% } else { %>
                <th scope="col-auto text-center" data-bs-toggle="tooltip" 
                data-bs-placement="top" 
                data-bs-title="Semestre al que se le impartirá la materia">Semestre</th>
                <% } %>
                <th scope="col text-center">Plan</th>
                <th scope="col text_center">Clave</th>
                <th scope="col">Materia</th>
                <th scope="col text-center">Hrs/semana</th>
                <th scope="col text-center">Créditos</th>
                <% if (editar == true) { %>
                  <th scope="col">Acciones</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% for (let i = 0; i < materias.length; i++) { %>
                <% const materia = materias[i]; %>
                <tr id="row-<%= materia.id_plan_materia %>">
                  <td class="text-center">
                    <% if (editar == true) { %>
                      <select class="form-select form-select-sm fs-5" 
                      aria-label="Default select example"
                      id="semestreSelect<%=materia.id_ciclo_escolar_materia%>"
                      name="semestreSelect<%=materia.id_ciclo_escolar_materia%>"
                      idMateria="<%=materia.id_ciclo_escolar_materia%>"
                      onchange="cambiarBloqueSemestre(`<%=materia.id_ciclo_escolar_materia%>`)">
                          <% for (j = 1; j < 10; j++) { %>
                            <% if (j !== materia.bloque_semestre) { %>
                              <option value="<%=j%>"><%=j%></option>
                            <% } else { %>
                              <option selected><%= materia.bloque_semestre %></option>
                            <% } %>
                          <% } %>
                      </select>
                    <% } else { %>
                      <%= materia.bloque_semestre %>
                    <% } %>
                  </td>
                  <td class="text-center"><%= materia.plan_estudio %></td>
                  <td class="text-center"><%= materia.id_materia %></td>
                  <td class="text-center"><%= materia.materia %></td>
                  <td class="text-center"><%= materia.horas_profesor %></td>
                  <td class="text-center"><%= materia.creditos %></td>
                  <% if (editar == true) { %>
                    <td class="text-center">
                      <button type="button" class="btn btn-outline-danger btn-sm eliminar-materia" data-id="<%= materia.id_plan_materia %>">
                        <i class="bi bi-dash-circle"></i>
                      </button>
                    </td>
                  <% } %>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  
  <!--Modal de confirmacion de eliminacion de materia-->
<div class="modal fade" id="confirmarEliminarModal" tabindex="-1" aria-labelledby="confirmarEliminarLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmarEliminarLabel">Confirmar eliminación</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar esta materia de la oferta académica?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" id="confirmarEliminarBtn" class="btn btn-danger">Eliminar</button>
      </div>
    </div>
  </div>
</div>

  <script>
  const csrfToken = "<%= csrfToken %>";
  const cicloActual = "<%= cicloActual %>";
  const planActual = "<%= planActual %>";
  </script>



  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
      popoverTriggerList.forEach((popoverTriggerEl) => {
        new bootstrap.Popover(popoverTriggerEl, {
          html: true
        });
      });
    });

    //Eliminar materia de oferta academica

  let idMateriaEliminar = null;
  let rowToDelete = null;

  document.querySelectorAll('.eliminar-materia').forEach(boton => {
    boton.addEventListener('click', function() {
      idMateriaEliminar = this.getAttribute('data-id');
      rowToDelete = this.closest('tr');
      const modal = new bootstrap.Modal(document.getElementById('confirmarEliminarModal'));
      modal.show();
    });
  });

  document.getElementById('confirmarEliminarBtn').addEventListener('click', function() {
    if (idMateriaEliminar) {
      fetch(`/oferta_academica/${cicloActual}/${planActual}/eliminar/${idMateriaEliminar}`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'CSRF-Token': csrfToken
        }
      })
        .then(response => {
          if (response.ok) {
            // Elimina la fila de la tabla sin recargar la página
            if (rowToDelete) rowToDelete.remove();
            // Cierra el modal
            bootstrap.Modal.getInstance(document.getElementById('confirmarEliminarModal')).hide();
          } else {
            alert('Error al eliminar la materia');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Error al eliminar la materia');
        });
    }
  });

  </script>
  <script type="text/javascript" src="//code.jquery.com/jquery-1.10.2.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js" integrity="sha384-b/U6ypiBEHpOf/4+1nzFpr53nxSS+GLCkfwBdFNTxtclqqenISfwAzpKaMNFNmj4" crossorigin="anonymous"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0-beta/js/bootstrap.min.js" integrity="sha384-h0AbiXch4ZDo7tp9hKZ4TsHbi047NrKGLO3SEJAg45jXxnGIfYzk4Si90RDIqNm1" crossorigin="anonymous"></script>
  <script src="/js/scriptIVD.js"></script>
  <script src="/js/listaOferta.js"></script>
</body>

</html>