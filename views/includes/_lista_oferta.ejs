<div class="container mt-4">
    <!-- Tabs de navegación (sin cambios visuales) -->
    <div class="row mb-3 p-3">
      <div class="col offset-1" id="col_tabs">
        <ul class="nav nav-underline">
          <li class="nav-item">
            <a class="nav-link link-dark active" aria-current="page" href="/oferta_academica/<%= cicloActual %>/plan_version">
              Materias seleccionadas
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link link-dark" href="/oferta_academica/<%= cicloActual %>/plan_version/agregar">
              Agregar materias
            </a>
          </li>
        </ul>
      </div>
    </div>
  
    <!-- Materias con nuevo estilo -->
    <div class="row g-4 justify-content-center px-3">
      <% for (let i = 0; i < materias.length; i++) { 
        const materia = materias[i]; %>
        <div class="col-sm-6 col-md-4 col-lg-3">
          <div class="card h-100 shadow-sm border-0 rounded-4">
            <img src="/images/95404c.png" class="card-img-top rounded-top-4" alt="color" height="150" />
            <div class="card-body d-flex flex-column justify-content-between">
              <h5 class="card-title text-center"><%= materia.nombreMateria %></h5>
              <div class="text-center mt-3">
                <button
                  class="btn btn-outline-secondary btn-sm rounded-pill"
                  data-bs-toggle="popover"
                  data-bs-title="Especificaciones"
                  data-bs-placement="bottom"
                  data-bs-content="Créditos: <%= materia.creditos %>"
                >
                  <i class="bi bi-info-circle"></i> Detalles
                </button>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
  

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
      popoverTriggerList.forEach((popoverTriggerEl) => {
        new bootstrap.Popover(popoverTriggerEl);
      });
    });
  </script>
    <script src="/js/scriptIVD.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>