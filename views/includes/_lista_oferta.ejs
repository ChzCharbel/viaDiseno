<div class="container mt-4">
    <!-- Tabs de navegación (sin cambios visuales) -->
    <div class="row mb-3 p-3">
      <div class="col offset-1" id="col_tabs">
        <ul class="nav nav-underline">
          <li class="nav-item">
            <a class="nav-link link-dark active" aria-current="page" href="/oferta_academica/<%= cicloActual %>/plan_version">
              Materias seleccionadas
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link link-dark" href="/oferta_academica/<%= cicloActual %>/plan_version/agregar">
              Agregar materias
            </a>
          </li>
        </ul>
      </div>
    </div>
  
    <!-- Tabla de materias -->
    <div class="row px-3">
      <div class="col-12">
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead class="table-light">
              <tr>
                <th scope="col">Plan</th>
                <th scope="col">Clave</th>
                <th scope="col">Materia</th>
                <th scope="col">Créditos</th>
                <th scope="col">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% for (let i = 0; i < materias.length; i++) { 
                const materia = materias[i]; %>
                <tr>
                  <td><%= materia.id_plan %></td>
                  <td><%= materia.id_materia %></td>
                  <td><%= materia.nombre_materia %></td>
                  <td><%= materia.creditos %></td>
                  <td>
                    <button
                      class="btn btn-outline-secondary btn-sm"
                      data-bs-toggle="popover"
                      data-bs-title="Detalles de la materia"
                      data-bs-placement="left"
                      data-bs-content="<%= materia.descripcion || 'Sin descripción disponible' %>"
                    >
                      <i class="bi bi-info-circle"></i> Más info
                    </button>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
      popoverTriggerList.forEach((popoverTriggerEl) => {
        new bootstrap.Popover(popoverTriggerEl, {
          html: true
        });
      });
    });
  </script>
    <script src="/js/scriptIVD.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>